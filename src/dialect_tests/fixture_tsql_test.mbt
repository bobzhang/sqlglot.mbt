let tsql_error_cases : Array[String] = [
  "parse_one", "tsql", "{}", "SELECT * FROM Table1 OPTION HASH GROUP", "ParseError", "Expecting (. Line 1, Col: 32.\n  SELECT * FROM Table1 OPTION \u{1b}[4mHASH\u{1b}[0m GROUP",
  "parse_one", "tsql", "{}", "SELECT * FROM Table1 OPTION(KEEPFIXED)", "ParseError", "Unknown option KEEPFIXED. Line 1, Col: 38.\n  SELECT * FROM Table1 OPTION(KEEPFIXED\u{1b}[4m)\u{1b}[0m",
  "parse_one", "tsql", "{}", "SELECT * FROM Table1 OPTION(HASH GROUP HASH GROUP)", "ParseError", "Expecting ). Line 1, Col: 49.\n  SELECT * FROM Table1 OPTION(HASH GROUP HASH \u{1b}[4mGROUP\u{1b}[0m)",
  "parse_one", "tsql", "{}", "SELECT TOP 2 x FROM t ORDER BY x OFFSET 0 ROWS FETCH FIRST 1 ROWS ONLY", "ParseError", "Invalid expression / Unexpected token. Line 1, Col: 52.\n  SELECT TOP 2 x FROM t ORDER BY x OFFSET 0 ROWS \u{1b}[4mFETCH\u{1b}[0m FIRST 1 ROWS ONLY",
  "parse_one", "tsql", "{}", "SELECT x FROM t ORDER BY x OFFSET 0 ROWS FETCH FIRST 1 ROWS ONLY FETCH FIRST 2 ROWS ONLY", "ParseError", "Found multiple 'FETCH' clauses. Line 1, Col: 70.\n  SELECT x FROM t ORDER BY x OFFSET 0 ROWS FETCH FIRST 1 ROWS ONLY \u{1b}[4mFETCH\u{1b}[0m FIRST 2 ROWS ONLY",
  "parse_one", "tsql", "{}", "SELECT begin", "ParseError", "Invalid expression / Unexpected token. Line 1, Col: 12.\n  SELECT \u{1b}[4mbegin\u{1b}[0m",
]

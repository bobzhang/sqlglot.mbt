  "", "snowflake", "I", "\n            MERGE a b USING c d ON b.id = d.id\n            WHEN MATCHED AND EXISTS (\n                SELECT b.name\n                EXCEPT\n                SELECT d.name\n            )\n            THEN UPDATE SET b.name = d.name\n            ",

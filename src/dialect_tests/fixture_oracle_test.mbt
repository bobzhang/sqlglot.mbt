  "parse_one", "oracle", "{\"error_level\":\"RAISE\"}", "SELECT * FROM tbl WITH", "ParseError", "Invalid expression / Unexpected token. Line 1, Col: 22.\n  SELECT * FROM tbl \u{1b}[4mWITH\u{1b}[0m",
  "parse_one", "oracle", "{\"error_level\":\"RAISE\"}", "SELECT * FROM tbl WITH READ", "ParseError", "Invalid expression / Unexpected token. Line 1, Col: 22.\n  SELECT * FROM tbl \u{1b}[4mWITH\u{1b}[0m READ",
  "parse_one", "oracle", "{\"error_level\":\"RAISE\"}", "SELECT * FROM tbl WITH GRANT OPTION", "ParseError", "Invalid expression / Unexpected token. Line 1, Col: 22.\n  SELECT * FROM tbl \u{1b}[4mWITH\u{1b}[0m GRANT OPTION",
  "parse_one", "oracle", "{\"error_level\":\"RAISE\"}", "SELECT * FROM t WITH x AS (SELECT 1) SELECT * FROM x", "ParseError", "Invalid expression / Unexpected token. Line 1, Col: 20.\n  SELECT * FROM t \u{1b}[4mWITH\u{1b}[0m x AS (SELECT 1) SELECT * FROM x",
]

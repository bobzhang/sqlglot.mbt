  "snowflake", "", "MINHASH_COMBINE(sig_col)", "MINHASH_COMBINE(sig_col)", "snowflake",
  "duckdb", "I", "MINHASH_COMBINE(sig_col)", "(SELECT JSON_OBJECT('state', LIST(min_h ORDER BY idx NULLS FIRST), 'type', 'minhash', 'version', 1) FROM (SELECT pos AS idx, MIN(val) AS min_h FROM UNNEST(LIST(sig_col)) AS _(sig) JOIN UNNEST(CAST(sig -> '$.state' AS UBIGINT[])) WITH ORDINALITY AS t(val, pos) ON TRUE GROUP BY pos))",
  "snowflake", "snowflake", "I", "MINHASH_COMBINE(sig_col)", "MINHASH_COMBINE(sig_col)",
  "snowflake", "snowflake", "", "APPROXIMATE_SIMILARITY(sig_col)", "APPROXIMATE_SIMILARITY(sig_col)",
  "snowflake", "duckdb", "I", "APPROXIMATE_SIMILARITY(sig_col)", "(SELECT CAST(SUM(CASE WHEN num_distinct = 1 THEN 1 ELSE 0 END) AS DOUBLE) / COUNT(*) FROM (SELECT pos, COUNT(DISTINCT h) AS num_distinct FROM (SELECT h, pos FROM UNNEST(LIST(sig_col)) AS _(sig) JOIN UNNEST(CAST(sig -> '$.state' AS UBIGINT[])) WITH ORDINALITY AS s(h, pos) ON TRUE) GROUP BY pos))",
  "snowflake", "snowflake", "I", "APPROXIMATE_SIMILARITY(sig_col)", "APPROXIMATE_SIMILARITY(sig_col)",

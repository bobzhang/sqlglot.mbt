// Direct assertions of tests/dialects/test_sqlite.py (the Validator checks are
// replayed from fixtures by src/dialect_tests).

///|
test "TestSQLite.test_sqlite" {
  let t = t(dialect="sqlite")
  let logs = t.assert_logs(level="WARNING", () => {
    t.validate_identity("SELECT a -> 'it''s' FROM t") |> ignore
    t.validate_identity("SELECT a ->> 'it''s' FROM t") |> ignore
  })
  t.eq(logs.length(), 2)
  t.ok(logs.iter().all(m => m.contains("Invalid JSON path syntax")))
  let fn_ = t
    .parse_one("SELECT JSON_EXTRACT(a, '$.k') FROM t")
    .selects()[0]
    .assert_is(JSONExtractScalar)
  let op = t
    .parse_one("SELECT a ->> '$.k' FROM t")
    .selects()[0]
    .assert_is(JSONExtractScalar)
  t.ok(fn_.bool_arg("json_subtype"))
  t.ok(fn_ != op)
  t.done()
}

///|
test "TestSQLite.test_warnings" {
  let t = t(dialect="sqlite")
  let logs = t.assert_logs(() => {
    t.validate_identity("SELECT * FROM t AS t(c1, c2)", write_sql="SELECT * FROM t AS t")
    |> ignore
  })
  t.contains(logs[0], "Named columns are not supported in table alias.")
  t.done()
}

///|
test "TestSQLite.test_trunc" {
  let t = t(dialect="sqlite")
  t.validate_identity("TRUNC(3.14)").assert_is(Trunc) |> ignore
  let logs = t.assert_logs(() => {
    t.validate_identity("TRUNC(3.14, 2)", write_sql="TRUNC(3.14)").assert_is(Trunc)
    |> ignore
  })
  t.contains(logs[0], "'decimals' is not supported")
  t.done()
}

///|
test "TestSQLite.test_unsupported_auto_increment" {
  let t = t(dialect="sqlite")
  for case in [
    ("postgres", "GENERATED BY DEFAULT AS IDENTITY", "a INTEGER"),
    ("mysql", "UNIQUE AUTO_INCREMENT", "a INTEGER UNIQUE"),
    ("snowflake", "AUTOINCREMENT", "a INTEGER"),
  ] {
    let (dialect, constraint, expected) = case
    let expression = parse_one(
      "CREATE TABLE t (a INT \{constraint})",
      read=dialect,
    )
    let message = "SQLite AUTOINCREMENT requires an INTEGER PRIMARY KEY"
    for level in [@core.ErrorLevel::Raise, Immediate] {
      t.raises(
        () => ignore(sql(expression, dialect="sqlite", unsupported_level=level)),
        "UnsupportedError",
        contains=message,
      )
      |> ignore
    }
    let logs = t.assert_logs(() => {
      t.eq(sql(expression, dialect="sqlite"), "CREATE TABLE t (\{expected})")
    })
    t.contains(logs[0], message)
  }
  t.done()
}

///|
test "TestSQLite.test_json_arrow_precedence" {
  let t = t(dialect="sqlite")
  let expr = t
    .parse_one(
      "SELECT a.data ->> b.key ->> a.final_key FROM source AS a JOIN keys AS b ON TRUE",
    )
    .selects()[0]
  t.is_a(t.is_a(Some(expr), JSONExtractScalar).this(), JSONExtractScalar) |> ignore
  let expr = t.parse_one("SELECT a || b COLLATE NOCASE FROM t").selects()[0]
  t.is_a(t.is_a(Some(expr), DPipe).expression(), Collate) |> ignore
  t.done()
}

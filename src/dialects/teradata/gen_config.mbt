///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.single_tokens.remove('%')
  t.keywords.remove("/*+")
  t.keywords["**"] = @core.TokenType::DSTAR
  t.keywords["^="] = @core.TokenType::NEQ
  t.keywords["BYTEINT"] = @core.TokenType::SMALLINT
  t.keywords["COLLECT"] = @core.TokenType::COMMAND
  t.keywords["DEL"] = @core.TokenType::DELETE
  t.keywords["EQ"] = @core.TokenType::EQ
  t.keywords["GE"] = @core.TokenType::GTE
  t.keywords["GT"] = @core.TokenType::GT
  t.keywords["HELP"] = @core.TokenType::COMMAND
  t.keywords["INS"] = @core.TokenType::INSERT
  t.keywords["LE"] = @core.TokenType::LTE
  t.keywords["LOCKING"] = @core.TokenType::LOCK
  t.keywords["LT"] = @core.TokenType::LT
  t.keywords["MINUS"] = @core.TokenType::EXCEPT
  t.keywords["MOD"] = @core.TokenType::MOD
  t.keywords["NE"] = @core.TokenType::NEQ
  t.keywords["NOT="] = @core.TokenType::NEQ
  t.keywords["SAMPLE"] = @core.TokenType::TABLE_SAMPLE
  t.keywords["SEL"] = @core.TokenType::SELECT
  t.keywords["ST_GEOMETRY"] = @core.TokenType::GEOMETRY
  t.keywords["TOP"] = @core.TokenType::TOP
  t.keywords["UPD"] = @core.TokenType::UPDATE
  t.hex_strings = [@core.QuoteSpec::Pair("X'", "'"), @core.QuoteSpec::Pair("x'", "'"), @core.QuoteSpec::Pair("0x", "")]
  t.byte_string_escapes = Some(["'"])
}


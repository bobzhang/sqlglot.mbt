  c.reserved_keywords = @set.Set::from_array(["alter", "and", "as", "between", "by", "case", "cast", "constraint", "create", "cross", "current_time", "current_timestamp", "deallocate", "delete", "describe", "distinct", "drop", "else", "end", "escape", "except", "execute", "exists", "extract", "false", "for", "from", "full", "group", "having", "in", "inner", "insert", "intersect", "into", "is", "join", "left", "like", "natural", "not", "null", "on", "or", "order", "outer", "prepare", "right", "select", "table", "then", "true", "union", "using", "values", "when", "where", "with"])
  c.select_kinds = []
  c.struct_delimiter = ["(", ")"]
  c.supports_decode_case = false
  c.supports_median = false
  c.supports_single_arg_concat = false
  c.supports_to_number = false
  c.table_hints = false
  c.type_mapping = Map::from_array([(@core.DType::DATETIME2, "TIMESTAMP"), (@core.DType::NCHAR, "CHAR"), (@core.DType::NVARCHAR, "VARCHAR"), (@core.DType::MEDIUMTEXT, "TEXT"), (@core.DType::LONGTEXT, "TEXT"), (@core.DType::TINYTEXT, "TEXT"), (@core.DType::BLOB, "VARBINARY"), (@core.DType::MEDIUMBLOB, "BLOB"), (@core.DType::LONGBLOB, "BLOB"), (@core.DType::TINYBLOB, "BLOB"), (@core.DType::INET, "INET"), (@core.DType::ROWVERSION, "VARBINARY"), (@core.DType::SMALLDATETIME, "TIMESTAMP"), (@core.DType::BINARY, "VARBINARY"), (@core.DType::BIT, "BOOLEAN"), (@core.DType::DATETIME, "TIMESTAMP"), (@core.DType::DATETIME64, "TIMESTAMP"), (@core.DType::FLOAT, "REAL"), (@core.DType::HLLSKETCH, "HYPERLOGLOG"), (@core.DType::INT, "INTEGER"), (@core.DType::STRUCT, "ROW"), (@core.DType::TEXT, "VARCHAR"), (@core.DType::TIMESTAMPTZ, "TIMESTAMP"), (@core.DType::TIMESTAMPNTZ, "TIMESTAMP"), (@core.DType::TIMETZ, "TIME")])
  c.tz_to_with_time_zone = true
}

///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords.remove("/*+")
  t.keywords.remove("QUALIFY")
  t.keywords["ROW"] = @core.TokenType::STRUCT
  t.keywords["DEALLOCATE PREPARE"] = @core.TokenType::COMMAND
  t.keywords["DESCRIBE INPUT"] = @core.TokenType::COMMAND
  t.keywords["DESCRIBE OUTPUT"] = @core.TokenType::COMMAND
  t.keywords["RESET SESSION"] = @core.TokenType::COMMAND
  t.keywords["START"] = @core.TokenType::BEGIN
  t.keywords["MATCH_RECOGNIZE"] = @core.TokenType::MATCH_RECOGNIZE
  t.keywords["IPADDRESS"] = @core.TokenType::IPADDRESS
  t.keywords["IPPREFIX"] = @core.TokenType::IPPREFIX
  t.keywords["TDIGEST"] = @core.TokenType::TDIGEST
  t.keywords["HYPERLOGLOG"] = @core.TokenType::HLLSKETCH
  t.hex_strings = [@core.QuoteSpec::Pair("x'", "'"), @core.QuoteSpec::Pair("X'", "'")]
  t.unicode_strings = [@core.QuoteSpec::Pair("U&'", "'"), @core.QuoteSpec::Pair("u&'", "'")]
  t.byte_string_escapes = Some(["'"])
  t.nested_comments = false
}


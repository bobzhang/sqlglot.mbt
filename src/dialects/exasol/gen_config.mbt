///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords.remove("DIV")
  t.keywords["USER"] = @core.TokenType::CURRENT_USER
  t.keywords["ENDIF"] = @core.TokenType::END
  t.keywords["LONG VARCHAR"] = @core.TokenType::TEXT
  t.keywords["REGEXP_LIKE"] = @core.TokenType::RLIKE
  t.keywords["SEPARATOR"] = @core.TokenType::SEPARATOR
  t.keywords["SYSTIMESTAMP"] = @core.TokenType::SYSTIMESTAMP
  t.keywords["MINUS"] = @core.TokenType::EXCEPT
  t.identifiers = [@core.QuoteSpec::Same("\""), @core.QuoteSpec::Pair("[", "]")]
  t.byte_string_escapes = Some(["'"])
}


  t.keywords["_UTF8MB4"] = @core.TokenType::INTRODUCER
  t.keywords["@@"] = @core.TokenType::SESSION_PARAMETER
  t.bit_strings = [@core.QuoteSpec::Pair("b'", "'"), @core.QuoteSpec::Pair("B'", "'"), @core.QuoteSpec::Pair("0b", "")]
  t.hex_strings = [@core.QuoteSpec::Pair("x'", "'"), @core.QuoteSpec::Pair("X'", "'"), @core.QuoteSpec::Pair("0x", "")]
  t.identifiers = [@core.QuoteSpec::Same("`")]
  t.quotes = [@core.QuoteSpec::Same("'"), @core.QuoteSpec::Same("\"")]

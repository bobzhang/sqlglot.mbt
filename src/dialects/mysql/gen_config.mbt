  t.byte_string_escapes = Some(["'", "\"", "\\"])
  t.nested_comments = false
  t.commands = [@core.TokenType::COMMAND, @core.TokenType::EXECUTE, @core.TokenType::FETCH, @core.TokenType::RENAME, @core.TokenType::REPLACE]

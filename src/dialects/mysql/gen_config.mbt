  t.keywords["_GREEK"] = @core.TokenType::INTRODUCER
  t.keywords["_HEBREW"] = @core.TokenType::INTRODUCER
  t.keywords["_HP8"] = @core.TokenType::INTRODUCER
  t.keywords["_KEYBCS2"] = @core.TokenType::INTRODUCER
  t.keywords["_KOI8R"] = @core.TokenType::INTRODUCER
  t.keywords["_KOI8U"] = @core.TokenType::INTRODUCER
  t.keywords["_LATIN1"] = @core.TokenType::INTRODUCER
  t.keywords["_LATIN2"] = @core.TokenType::INTRODUCER
  t.keywords["_LATIN5"] = @core.TokenType::INTRODUCER
  t.keywords["_LATIN7"] = @core.TokenType::INTRODUCER

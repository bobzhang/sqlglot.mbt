///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords["BLOB"] = @core.TokenType::BLOB
  t.keywords["TIMESTAMP"] = @core.TokenType::TIMESTAMPTZ
  t.keywords["EXPLAIN"] = @core.TokenType::DESCRIBE
  t.keywords["CHARSET"] = @core.TokenType::CHARACTER_SET
  t.keywords["DISTINCTROW"] = @core.TokenType::DISTINCT
  t.keywords["FORCE"] = @core.TokenType::FORCE
  t.keywords["IGNORE"] = @core.TokenType::IGNORE
  t.keywords["KEY"] = @core.TokenType::KEY
  t.keywords["LOCK TABLES"] = @core.TokenType::COMMAND
  t.keywords["MEMBER OF"] = @core.TokenType::MEMBER_OF
  t.keywords["MOD"] = @core.TokenType::MOD
  t.keywords["SEPARATOR"] = @core.TokenType::SEPARATOR
  t.keywords["SERIAL"] = @core.TokenType::SERIAL
  t.keywords["SIGNED"] = @core.TokenType::BIGINT
  t.keywords["SIGNED INTEGER"] = @core.TokenType::BIGINT
  t.keywords["START"] = @core.TokenType::BEGIN
  t.keywords["UNLOCK TABLES"] = @core.TokenType::COMMAND
  t.keywords["UNSIGNED"] = @core.TokenType::UBIGINT
  t.keywords["UNSIGNED INTEGER"] = @core.TokenType::UBIGINT
  t.keywords["YEAR"] = @core.TokenType::YEAR
  t.keywords["_ARMSCII8"] = @core.TokenType::INTRODUCER
  t.keywords["_ASCII"] = @core.TokenType::INTRODUCER
  t.keywords["_BIG5"] = @core.TokenType::INTRODUCER

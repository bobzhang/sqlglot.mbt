  t.keywords["_CP852"] = @core.TokenType::INTRODUCER
  t.keywords["_CP866"] = @core.TokenType::INTRODUCER
  t.keywords["_CP932"] = @core.TokenType::INTRODUCER
  t.keywords["_DEC8"] = @core.TokenType::INTRODUCER
  t.keywords["_EUCJPMS"] = @core.TokenType::INTRODUCER
  t.keywords["_EUCKR"] = @core.TokenType::INTRODUCER
  t.keywords["_GB18030"] = @core.TokenType::INTRODUCER
  t.keywords["_GB2312"] = @core.TokenType::INTRODUCER
  t.keywords["_GBK"] = @core.TokenType::INTRODUCER

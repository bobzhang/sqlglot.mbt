///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords.remove("/*+")
  t.keywords["TINYINT"] = @core.TokenType::UTINYINT
  t.keywords["TIMESTAMP"] = @core.TokenType::ROWVERSION
  t.keywords["CLUSTERED INDEX"] = @core.TokenType::INDEX
  t.keywords["DATETIME2"] = @core.TokenType::DATETIME2
  t.keywords["DATETIMEOFFSET"] = @core.TokenType::TIMESTAMPTZ
  t.keywords["DECLARE"] = @core.TokenType::DECLARE
  t.keywords["EXEC"] = @core.TokenType::EXECUTE
  t.keywords["GO"] = @core.TokenType::COMMAND
  t.keywords["IMAGE"] = @core.TokenType::IMAGE
  t.keywords["MONEY"] = @core.TokenType::MONEY
  t.keywords["NONCLUSTERED INDEX"] = @core.TokenType::INDEX
  t.keywords["NTEXT"] = @core.TokenType::TEXT
  t.keywords["OPTION"] = @core.TokenType::OPTION
  t.keywords["OUTPUT"] = @core.TokenType::RETURNING
  t.keywords["PRINT"] = @core.TokenType::COMMAND
  t.keywords["PROC"] = @core.TokenType::PROCEDURE
  t.keywords["ROWVERSION"] = @core.TokenType::ROWVERSION
  t.keywords["SMALLDATETIME"] = @core.TokenType::SMALLDATETIME
  t.keywords["SMALLMONEY"] = @core.TokenType::SMALLMONEY
  t.keywords["SQL_VARIANT"] = @core.TokenType::VARIANT
  t.keywords["SYSTEM_USER"] = @core.TokenType::CURRENT_USER
  t.keywords["TOP"] = @core.TokenType::TOP
  t.keywords["UNIQUEIDENTIFIER"] = @core.TokenType::UUID
  t.keywords["UPDATE STATISTICS"] = @core.TokenType::COMMAND
  t.keywords["XML"] = @core.TokenType::XML
  t.hex_strings = [@core.QuoteSpec::Pair("0x", ""), @core.QuoteSpec::Pair("0X", "")]
  t.identifiers = [@core.QuoteSpec::Pair("[", "]"), @core.QuoteSpec::Same("\"")]
  t.quotes = [@core.QuoteSpec::Same("'"), @core.QuoteSpec::Same("\"")]
  t.byte_string_escapes = Some(["'"])
  t.var_single_tokens = ['#', '$', '@']
  t.commands = [@core.TokenType::COMMAND, @core.TokenType::END, @core.TokenType::FETCH, @core.TokenType::RENAME, @core.TokenType::SHOW]
}


    @core.Kind::JSONPathSubscript,
  ]
  c.supports_alter_column_if_exists = true
  c.supports_decode_case = false
  c.supports_to_number = false
  c.supports_uescape = false
  c.tablesample_keywords = "SAMPLE"
  c.tablesample_requires_parens = false
  c.tablesample_size_is_rows = false
  c.table_hints = false
  c.try_supported = false
  c.type_mapping = Map::from_array([
    (@core.DType::DATETIME2, "DateTime"),
    (@core.DType::NCHAR, "CHAR"),
    (@core.DType::NVARCHAR, "VARCHAR"),
    (@core.DType::MEDIUMTEXT, "String"),
    (@core.DType::LONGTEXT, "String"),
    (@core.DType::TINYTEXT, "String"),
    (@core.DType::BLOB, "String"),
    (@core.DType::MEDIUMBLOB, "String"),
    (@core.DType::LONGBLOB, "String"),
    (@core.DType::TINYBLOB, "String"),
    (@core.DType::INET, "INET"),
    (@core.DType::ROWVERSION, "VARBINARY"),
    (@core.DType::SMALLDATETIME, "DateTime"),
    (@core.DType::CHAR, "String"),
    (@core.DType::TEXT, "String"),
    (@core.DType::VARBINARY, "String"),
    (@core.DType::VARCHAR, "String"),
    (@core.DType::ARRAY, "Array"),
    (@core.DType::BOOLEAN, "Bool"),
    (@core.DType::BIGINT, "Int64"),
    (@core.DType::DATE32, "Date32"),
    (@core.DType::DATETIME, "DateTime"),
    (@core.DType::DATETIME64, "DateTime64"),
    (@core.DType::DECIMAL, "Decimal"),
    (@core.DType::DECIMAL32, "Decimal32"),
    (@core.DType::DECIMAL64, "Decimal64"),
    (@core.DType::DECIMAL128, "Decimal128"),
    (@core.DType::DECIMAL256, "Decimal256"),
    (@core.DType::TIMESTAMP, "DateTime"),
    (@core.DType::TIMESTAMPNTZ, "DateTime"),
    (@core.DType::TIMESTAMPTZ, "DateTime"),
    (@core.DType::DOUBLE, "Float64"),
    (@core.DType::ENUM, "Enum"),
    (@core.DType::ENUM8, "Enum8"),
    (@core.DType::ENUM16, "Enum16"),
    (@core.DType::FIXEDSTRING, "FixedString"),
    (@core.DType::FLOAT, "Float32"),
    (@core.DType::INT, "Int32"),
    (@core.DType::MEDIUMINT, "Int32"),
    (@core.DType::INT128, "Int128"),
    (@core.DType::INT256, "Int256"),
    (@core.DType::LOWCARDINALITY, "LowCardinality"),
    (@core.DType::MAP, "Map"),
    (@core.DType::NESTED, "Nested"),
    (@core.DType::NOTHING, "Nothing"),
    (@core.DType::SMALLINT, "Int16"),
    (@core.DType::STRUCT, "Tuple"),
    (@core.DType::TINYINT, "Int8"),
    (@core.DType::UBIGINT, "UInt64"),
    (@core.DType::UINT, "UInt32"),
    (@core.DType::UINT128, "UInt128"),
    (@core.DType::UINT256, "UInt256"),
    (@core.DType::USMALLINT, "UInt16"),
    (@core.DType::UTINYINT, "UInt8"),
    (@core.DType::IPV4, "IPv4"),
    (@core.DType::IPV6, "IPv6"),
    (@core.DType::POINT, "Point"),
    (@core.DType::RING, "Ring"),
    (@core.DType::LINESTRING, "LineString"),
    (@core.DType::MULTILINESTRING, "MultiLineString"),
    (@core.DType::POLYGON, "Polygon"),
    (@core.DType::MULTIPOLYGON, "MultiPolygon"),
    (@core.DType::AGGREGATEFUNCTION, "AggregateFunction"),
    (@core.DType::SIMPLEAGGREGATEFUNCTION, "SimpleAggregateFunction"),
    (@core.DType::DYNAMIC, "Dynamic"),
  ])
  c.wrap_derived_values = false
}

///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.single_tokens['$'] = @core.TokenType::HEREDOC_STRING
  t.keywords.remove("/*+")
  t.keywords[".:"] = @core.TokenType::DOTCOLON
  t.keywords[".^"] = @core.TokenType::DOTCARET
  t.keywords["ATTACH"] = @core.TokenType::COMMAND
  t.keywords["DATE32"] = @core.TokenType::DATE32
  t.keywords["DETACH"] = @core.TokenType::DETACH
  t.keywords["DATETIME64"] = @core.TokenType::DATETIME64
  t.keywords["DICTIONARY"] = @core.TokenType::DICTIONARY
  t.keywords["DYNAMIC"] = @core.TokenType::DYNAMIC
  t.keywords["ENUM8"] = @core.TokenType::ENUM8
  t.keywords["ENUM16"] = @core.TokenType::ENUM16
  t.keywords["EXCHANGE"] = @core.TokenType::COMMAND
  t.keywords["FINAL"] = @core.TokenType::FINAL
  t.keywords["FIXEDSTRING"] = @core.TokenType::FIXEDSTRING
  t.keywords["FLOAT32"] = @core.TokenType::FLOAT
  t.keywords["FLOAT64"] = @core.TokenType::DOUBLE
  t.keywords["GLOBAL"] = @core.TokenType::GLOBAL
  t.keywords["LOWCARDINALITY"] = @core.TokenType::LOWCARDINALITY
  t.keywords["NESTED"] = @core.TokenType::NESTED
  t.keywords["NOTHING"] = @core.TokenType::NOTHING
  t.keywords["SAMPLE"] = @core.TokenType::TABLE_SAMPLE
  t.keywords["TUPLE"] = @core.TokenType::STRUCT
  t.keywords["UINT16"] = @core.TokenType::USMALLINT
  t.keywords["UINT32"] = @core.TokenType::UINT
  t.keywords["UINT64"] = @core.TokenType::UBIGINT
  t.keywords["UINT8"] = @core.TokenType::UTINYINT
  t.keywords["IPV4"] = @core.TokenType::IPV4
  t.keywords["IPV6"] = @core.TokenType::IPV6
  t.keywords["POINT"] = @core.TokenType::POINT
  t.keywords["PROJECTION"] = @core.TokenType::PROJECTION
  t.keywords["RING"] = @core.TokenType::RING
  t.keywords["LINESTRING"] = @core.TokenType::LINESTRING
  t.keywords["MULTILINESTRING"] = @core.TokenType::MULTILINESTRING
  t.keywords["POLYGON"] = @core.TokenType::POLYGON
  t.keywords["MULTIPOLYGON"] = @core.TokenType::MULTIPOLYGON
  t.keywords["AGGREGATEFUNCTION"] = @core.TokenType::AGGREGATEFUNCTION
  t.keywords["SIMPLEAGGREGATEFUNCTION"] = @core.TokenType::SIMPLEAGGREGATEFUNCTION
  t.keywords["SYSTEM"] = @core.TokenType::COMMAND
  t.keywords["PREWHERE"] = @core.TokenType::PREWHERE
  t.bit_strings = [@core.QuoteSpec::Pair("0b", "")]
  t.hex_strings = [
    @core.QuoteSpec::Pair("0x", ""),
    @core.QuoteSpec::Pair("0X", ""),
  ]
  t.heredoc_strings = [@core.QuoteSpec::Same("$")]
  t.identifiers = [@core.QuoteSpec::Same("\""), @core.QuoteSpec::Same("`")]
  t.comments = [
    @core.QuoteSpec::Same("--"),
    @core.QuoteSpec::Same("#"),
    @core.QuoteSpec::Same("#!"),
    @core.QuoteSpec::Pair("/*", "*/"),
  ]
  t.string_escapes = ["'", "\\"]
  t.identifier_escapes = ["\\"]
  t.byte_string_escapes = Some(["'", "\\"])
}

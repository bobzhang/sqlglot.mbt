  c.type_mapping = Map::from_array([(@core.DType::DATETIME2, "TIMESTAMP"), (@core.DType::NCHAR, "NCHAR"), (@core.DType::NVARCHAR, "NVARCHAR2"), (@core.DType::MEDIUMTEXT, "TEXT"), (@core.DType::LONGTEXT, "TEXT"), (@core.DType::TINYTEXT, "TEXT"), (@core.DType::BLOB, "BLOB"), (@core.DType::MEDIUMBLOB, "BLOB"), (@core.DType::LONGBLOB, "BLOB"), (@core.DType::TINYBLOB, "BLOB"), (@core.DType::INET, "INET"), (@core.DType::ROWVERSION, "BLOB"), (@core.DType::SMALLDATETIME, "TIMESTAMP"), (@core.DType::TINYINT, "SMALLINT"), (@core.DType::SMALLINT, "SMALLINT"), (@core.DType::INT, "INT"), (@core.DType::BIGINT, "INT"), (@core.DType::DECIMAL, "NUMBER"), (@core.DType::DOUBLE, "DOUBLE PRECISION"), (@core.DType::VARCHAR, "VARCHAR2"), (@core.DType::TEXT, "CLOB"), (@core.DType::TIMETZ, "TIME"), (@core.DType::TIMESTAMPNTZ, "TIMESTAMP"), (@core.DType::TIMESTAMPTZ, "TIMESTAMP"), (@core.DType::BINARY, "BLOB"), (@core.DType::VARBINARY, "BLOB")])
  c.tz_to_with_time_zone = true
  c.unpivot_aliases_are_identifiers = false
}

///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords["(+)"] = @core.TokenType::JOIN_MARKER
  t.keywords["^="] = @core.TokenType::NEQ
  t.keywords["BINARY_DOUBLE"] = @core.TokenType::DOUBLE
  t.keywords["BINARY_FLOAT"] = @core.TokenType::FLOAT
  t.keywords["BULK COLLECT INTO"] = @core.TokenType::BULK_COLLECT_INTO
  t.keywords["COLUMNS"] = @core.TokenType::COLUMN
  t.keywords["MATCH_RECOGNIZE"] = @core.TokenType::MATCH_RECOGNIZE
  t.keywords["MINUS"] = @core.TokenType::EXCEPT
  t.keywords["ORDER SIBLINGS BY"] = @core.TokenType::ORDER_SIBLINGS_BY
  t.keywords["SAMPLE"] = @core.TokenType::TABLE_SAMPLE
  t.keywords["START"] = @core.TokenType::BEGIN
  t.keywords["TOP"] = @core.TokenType::TOP
  t.keywords["SYSTIMESTAMP"] = @core.TokenType::SYSTIMESTAMP
  t.unicode_strings = [@core.QuoteSpec::Pair("U'", "'"), @core.QuoteSpec::Pair("u'", "'")]
  t.byte_string_escapes = Some(["'"])
  t.var_single_tokens = ['#', '$', '@']
  t.nested_comments = false
}


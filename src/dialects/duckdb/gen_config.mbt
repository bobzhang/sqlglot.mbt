///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.single_tokens['$'] = @core.TokenType::PARAMETER
  t.keywords.remove("/*+")
  t.keywords["ROW"] = @core.TokenType::STRUCT
  t.keywords["INT8"] = @core.TokenType::BIGINT
  t.keywords["CHAR"] = @core.TokenType::TEXT
  t.keywords["VARCHAR"] = @core.TokenType::TEXT
  t.keywords["BPCHAR"] = @core.TokenType::TEXT
  t.keywords["BINARY"] = @core.TokenType::VARBINARY
  t.keywords["TIMESTAMP"] = @core.TokenType::TIMESTAMPNTZ
  t.keywords["DATETIME"] = @core.TokenType::TIMESTAMPNTZ
  t.keywords["//"] = @core.TokenType::DIV
  t.keywords["**"] = @core.TokenType::DSTAR
  t.keywords["^@"] = @core.TokenType::CARET_AT
  t.keywords["@>"] = @core.TokenType::AT_GT
  t.keywords["<@"] = @core.TokenType::LT_AT
  t.keywords["ATTACH"] = @core.TokenType::ATTACH
  t.keywords["BITSTRING"] = @core.TokenType::BIT
  t.keywords["DETACH"] = @core.TokenType::DETACH
  t.keywords["FORCE"] = @core.TokenType::FORCE
  t.keywords["INSTALL"] = @core.TokenType::INSTALL
  t.keywords["LOGICAL"] = @core.TokenType::BOOLEAN
  t.keywords["MACRO"] = @core.TokenType::FUNCTION
  t.keywords["ONLY"] = @core.TokenType::ONLY
  t.keywords["PIVOT_WIDER"] = @core.TokenType::PIVOT
  t.keywords["POSITIONAL"] = @core.TokenType::POSITIONAL
  t.keywords["RESET"] = @core.TokenType::COMMAND
  t.keywords["SIGNED"] = @core.TokenType::INT
  t.keywords["SUMMARIZE"] = @core.TokenType::SUMMARIZE
  t.keywords["TIMESTAMP_S"] = @core.TokenType::TIMESTAMP_S
  t.keywords["TIMESTAMP_MS"] = @core.TokenType::TIMESTAMP_MS
  t.keywords["TIMESTAMP_NS"] = @core.TokenType::TIMESTAMP_NS
  t.keywords["TIMESTAMP_US"] = @core.TokenType::TIMESTAMP
  t.keywords["UBIGINT"] = @core.TokenType::UBIGINT
  t.keywords["UINTEGER"] = @core.TokenType::UINT
  t.keywords["USMALLINT"] = @core.TokenType::USMALLINT
  t.keywords["UTINYINT"] = @core.TokenType::UTINYINT
  t.byte_strings = [@core.QuoteSpec::Pair("e'", "'"), @core.QuoteSpec::Pair("E'", "'")]
  t.heredoc_strings = [@core.QuoteSpec::Same("$")]
  t.byte_string_escapes = Some(["'", "\\"])
  t.var_single_tokens = ['$']
  t.heredoc_tag_is_identifier = true
  t.heredoc_string_alternative = @core.TokenType::PARAMETER
  t.commands = [@core.TokenType::COMMAND, @core.TokenType::EXECUTE, @core.TokenType::FETCH, @core.TokenType::RENAME]
}


///|
fn apply_dialect_config(c : @core.DialectConfig) -> Unit {
  c.ascii_only_normalization = true
  c.concat_coalesce = true
  c.concat_ws_coalesce = true
  c.hex_end = Some("'")
  c.hex_start = Some("x'")
  c.initcap_supports_custom_delimiters = false
  c.normalization_strategy = @core.NormalizationStrategy::CaseInsensitive
  c.safe_division = true
  c.safe_to_eliminate_double_negation = false
  c.typed_division = true
}


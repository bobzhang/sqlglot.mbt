///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords.remove("/*+")
  t.keywords["ATTACH"] = @core.TokenType::ATTACH
  t.keywords["DETACH"] = @core.TokenType::DETACH
  t.keywords["INDEXED BY"] = @core.TokenType::INDEXED_BY
  t.keywords["MATCH"] = @core.TokenType::MATCH
  t.hex_strings = [
    @core.QuoteSpec::Pair("x'", "'"),
    @core.QuoteSpec::Pair("X'", "'"),
    @core.QuoteSpec::Pair("0x", ""),
    @core.QuoteSpec::Pair("0X", ""),
  ]
  t.identifiers = [
    @core.QuoteSpec::Same("\""),
    @core.QuoteSpec::Pair("[", "]"),
    @core.QuoteSpec::Same("`"),
  ]
  t.byte_string_escapes = Some(["'"])
  t.nested_comments = false
  t.commands = [
    @core.TokenType::COMMAND,
    @core.TokenType::EXECUTE,
    @core.TokenType::FETCH,
    @core.TokenType::RENAME,
    @core.TokenType::REPLACE,
    @core.TokenType::SHOW,
  ]
}

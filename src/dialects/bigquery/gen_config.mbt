  c.with_properties_prefix = "OPTIONS"
}

///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.keywords.remove("/*+")
  t.keywords.remove("DIV")
  t.keywords.remove("VALUES")
  t.keywords["BEGIN"] = @core.TokenType::COMMAND
  t.keywords["TIMESTAMP"] = @core.TokenType::TIMESTAMPTZ
  t.keywords["DATETIME"] = @core.TokenType::TIMESTAMP
  t.keywords["ANY TYPE"] = @core.TokenType::VARIANT
  t.keywords["BEGIN TRANSACTION"] = @core.TokenType::BEGIN
  t.keywords["BYTEINT"] = @core.TokenType::INT
  t.keywords["BYTES"] = @core.TokenType::BINARY
  t.keywords["CURRENT_DATETIME"] = @core.TokenType::CURRENT_DATETIME
  t.keywords["DECLARE"] = @core.TokenType::DECLARE
  t.keywords["ELSEIF"] = @core.TokenType::COMMAND
  t.keywords["EXCEPTION"] = @core.TokenType::COMMAND
  t.keywords["EXPORT"] = @core.TokenType::EXPORT
  t.keywords["FLOAT64"] = @core.TokenType::DOUBLE
  t.keywords["LOOP"] = @core.TokenType::COMMAND
  t.keywords["MODEL"] = @core.TokenType::MODEL
  t.keywords["RECORD"] = @core.TokenType::STRUCT
  t.keywords["REPEAT"] = @core.TokenType::COMMAND
  t.keywords["WHILE"] = @core.TokenType::COMMAND
  t.byte_strings = [
    @core.QuoteSpec::Pair("b'", "'"),
    @core.QuoteSpec::Pair("B'", "'"),
    @core.QuoteSpec::Pair("b\"", "\""),
    @core.QuoteSpec::Pair("B\"", "\""),
    @core.QuoteSpec::Pair("b\"\"\"", "\"\"\""),
    @core.QuoteSpec::Pair("B\"\"\"", "\"\"\""),
    @core.QuoteSpec::Pair("b'''", "'''"),
    @core.QuoteSpec::Pair("B'''", "'''"),
  ]
  t.hex_strings = [
    @core.QuoteSpec::Pair("0x", ""),
    @core.QuoteSpec::Pair("0X", ""),
  ]
  t.raw_strings = [
    @core.QuoteSpec::Pair("r'", "'"),
    @core.QuoteSpec::Pair("R'", "'"),
    @core.QuoteSpec::Pair("r\"", "\""),
    @core.QuoteSpec::Pair("R\"", "\""),
    @core.QuoteSpec::Pair("r\"\"\"", "\"\"\""),
    @core.QuoteSpec::Pair("R\"\"\"", "\"\"\""),
    @core.QuoteSpec::Pair("r'''", "'''"),
    @core.QuoteSpec::Pair("R'''", "'''"),
  ]
  t.identifiers = [@core.QuoteSpec::Same("`")]
  t.quotes = [
    @core.QuoteSpec::Same("'"),
    @core.QuoteSpec::Same("\""),
    @core.QuoteSpec::Same("\"\"\""),
    @core.QuoteSpec::Same("'''"),
  ]
  t.comments = [
    @core.QuoteSpec::Same("--"),
    @core.QuoteSpec::Same("#"),
    @core.QuoteSpec::Pair("/*", "*/"),
  ]
  t.string_escapes = ["\\"]
  t.byte_string_escapes = Some(["\\"])
  t.nested_comments = false
}

///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.single_tokens['$'] = @core.TokenType::HEREDOC_STRING
  t.keywords.remove("/*+")
  t.keywords.remove("DIV")
  t.keywords["INT8"] = @core.TokenType::BIGINT
  t.keywords["FLOAT"] = @core.TokenType::DOUBLE
  t.keywords["~"] = @core.TokenType::RLIKE
  t.keywords["@@"] = @core.TokenType::DAT
  t.keywords["@?"] = @core.TokenType::AT_QMARK
  t.keywords["@>"] = @core.TokenType::AT_GT
  t.keywords["<@"] = @core.TokenType::LT_AT
  t.keywords["?&"] = @core.TokenType::QMARK_AMP
  t.keywords["?|"] = @core.TokenType::QMARK_PIPE
  t.keywords["#-"] = @core.TokenType::HASH_DASH
  t.keywords["|/"] = @core.TokenType::PIPE_SLASH
  t.keywords["||/"] = @core.TokenType::DPIPE_SLASH
  t.keywords["BIGSERIAL"] = @core.TokenType::BIGSERIAL
  t.keywords["CSTRING"] = @core.TokenType::PSEUDO_TYPE
  t.keywords["DECLARE"] = @core.TokenType::COMMAND
  t.keywords["DO"] = @core.TokenType::COMMAND
  t.keywords["EXEC"] = @core.TokenType::COMMAND
  t.keywords["HSTORE"] = @core.TokenType::HSTORE
  t.keywords["MONEY"] = @core.TokenType::MONEY
  t.keywords["NAME"] = @core.TokenType::NAME
  t.keywords["OID"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["ONLY"] = @core.TokenType::ONLY
  t.keywords["POINT"] = @core.TokenType::POINT
  t.keywords["REFRESH"] = @core.TokenType::COMMAND
  t.keywords["REINDEX"] = @core.TokenType::COMMAND
  t.keywords["RESET"] = @core.TokenType::COMMAND
  t.keywords["SERIAL"] = @core.TokenType::SERIAL
  t.keywords["SMALLSERIAL"] = @core.TokenType::SMALLSERIAL
  t.keywords["TYPE"] = @core.TokenType::TYPE
  t.keywords["REGCLASS"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGCOLLATION"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGCONFIG"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGDICTIONARY"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGNAMESPACE"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGOPER"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGOPERATOR"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGPROC"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGPROCEDURE"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGROLE"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["REGTYPE"] = @core.TokenType::OBJECT_IDENTIFIER
  t.keywords["XML"] = @core.TokenType::XML
  t.keywords["VARIADIC"] = @core.TokenType::VARIADIC
  t.keywords["INOUT"] = @core.TokenType::INOUT
  t.bit_strings = [@core.QuoteSpec::Pair("b'", "'"), @core.QuoteSpec::Pair("B'", "'")]
  t.byte_strings = [@core.QuoteSpec::Pair("e'", "'"), @core.QuoteSpec::Pair("E'", "'")]
  t.hex_strings = [@core.QuoteSpec::Pair("x'", "'"), @core.QuoteSpec::Pair("X'", "'")]
  t.heredoc_strings = [@core.QuoteSpec::Same("$")]
  t.unicode_strings = [@core.QuoteSpec::Pair("U&'", "'"), @core.QuoteSpec::Pair("u&'", "'")]
  t.byte_string_escapes = Some(["'", "\\"])
  t.var_single_tokens = ['$']
  t.heredoc_tag_is_identifier = true
  t.heredoc_string_alternative = @core.TokenType::PARAMETER
  t.commands = [@core.TokenType::COMMAND, @core.TokenType::EXECUTE, @core.TokenType::FETCH, @core.TokenType::LOCK, @core.TokenType::RENAME, @core.TokenType::SHOW]
}


///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.single_tokens['$'] = @core.TokenType::PARAMETER
  t.keywords["ADD ARCHIVE"] = @core.TokenType::COMMAND
  t.keywords["ADD ARCHIVES"] = @core.TokenType::COMMAND
  t.keywords["ADD FILE"] = @core.TokenType::COMMAND
  t.keywords["ADD FILES"] = @core.TokenType::COMMAND
  t.keywords["ADD JAR"] = @core.TokenType::COMMAND
  t.keywords["ADD JARS"] = @core.TokenType::COMMAND
  t.keywords["MINUS"] = @core.TokenType::EXCEPT
  t.keywords["MSCK REPAIR"] = @core.TokenType::COMMAND
  t.keywords["REFRESH"] = @core.TokenType::REFRESH
  t.keywords["SERDEPROPERTIES"] = @core.TokenType::SERDE_PROPERTIES
  t.identifiers = [@core.QuoteSpec::Same("`")]
  t.quotes = [@core.QuoteSpec::Same("'"), @core.QuoteSpec::Same("\"")]
  t.string_escapes = ["\\"]
  t.byte_string_escapes = Some(["\\"])
  t.numeric_literals = {
    "L": "BIGINT",
    "S": "SMALLINT",
    "Y": "TINYINT",
    "D": "DOUBLE",
    "F": "FLOAT",
    "BD": "DECIMAL",
  }
}

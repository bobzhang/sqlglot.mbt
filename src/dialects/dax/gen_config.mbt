///|
fn apply_generator_config(c : @core.GeneratorConfig) -> Unit {
  ignore(c)
}

///|
fn apply_tokenizer_config(t : @core.TokenizerSettings) -> Unit {
  t.identifiers = [@core.QuoteSpec::Same("'"), @core.QuoteSpec::Pair("[", "]")]
  t.quotes = [@core.QuoteSpec::Same("\"")]
  t.comments = [
    @core.QuoteSpec::Same("--"),
    @core.QuoteSpec::Same("//"),
    @core.QuoteSpec::Pair("/*", "*/"),
  ]
  t.string_escapes = ["\""]
  t.byte_string_escapes = Some(["\""])
}

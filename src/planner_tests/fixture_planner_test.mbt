  "tpch",
  "select\n        supp_nation,\n        cust_nation,\n        l_year,\n        sum(volume) as revenue\nfrom\n        (\n                select\n                        n1.n_name as supp_nation,\n                        n2.n_name as cust_nation,\n                        extract(year from cast(l_shipdate as date)) as l_year,\n                        l_extendedprice * (1 - l_discount) as volume\n                from\n                        supplier,\n                        lineitem,\n                        orders,\n                        customer,\n                        nation n1,\n                        nation n2\n                where\n                        s_suppkey = l_suppkey\n                        and o_orderkey = l_orderkey\n                        and c_custkey = o_custkey\n                        and s_nationkey = n1.n_nationkey\n                        and c_nationkey = n2.n_nationkey\n                        and (\n                                (n1.n_name = 'FRANCE' and n2.n_name = 'GERMANY')\n                                or (n1.n_name = 'GERMANY' and n2.n_name = 'FRANCE')\n                        )\n                        and CAST(l_shipdate AS DATE) between date '1995-01-01' and date '1996-12-31'\n        ) as shipping\ngroup by\n        supp_nation,\n        cust_nation,\n        l_year\norder by\n        supp_nation,\n        cust_nation,\n        l_year",
  "- Sort: supplier\n    Context:\n      Key:\n        - \"supp_nation\"\n        - \"cust_nation\"\n        - \"l_year\"\n    Projections:\n      - supplier._g0 AS \"supp_nation\"\n      - supplier._g1 AS \"cust_nation\"\n      - supplier._g2 AS \"l_year\"\n      - \"supplier\".\"revenue\"\n    Dependencies:\n    - Aggregate: supplier\n      Context:\n        Aggregations:\n          - SUM(\"_a_0\") AS \"revenue\"\n        Group:\n          - \"n1\".\"n_name\"\n          - \"n2\".\"n_name\"\n          - EXTRACT(YEAR FROM CAST(\"lineitem\".\"l_shipdate\" AS DATE))\n        Operands:\n          - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_0\n      Projections:\n      Dependencies:\n      - Join: supplier\n        Context:\n          Source: supplier\n          lineitem: INNER\n          Key: \"lineitem\".\"l_suppkey\"\n          On: TRUE AND TRUE\n          n1: INNER\n          Key: \"n1\".\"n_nationkey\"\n          On: TRUE AND TRUE\n          orders: INNER\n          Key: \"orders\".\"o_orderkey\"\n          On: TRUE AND TRUE\n          customer: INNER\n          Key: \"customer\".\"c_custkey\"\n          On: TRUE AND TRUE\n          n2: INNER\n          Key: \"n2\".\"n_nationkey\"\n          On: TRUE AND (\"n1\".\"n_name\" = 'FRANCE' OR \"n2\".\"n_name\" = 'FRANCE') AND (\"n1\".\"n_name\" = 'GERMANY' OR \"n2\".\"n_name\" = 'GERMANY')\n        Projections:\n        Dependencies:\n        - Scan: customer\n          Context:\n            Source: \"customer_2\" AS \"customer\"\n          Projections:\n          Dependencies:\n          - Join: customer_2\n            Context:\n              Source: customer\n            Projections:\n              - \"customer\".\"c_custkey\" AS \"c_custkey\"\n              - \"customer\".\"c_nationkey\" AS \"c_nationkey\"\n            Dependencies:\n            - Scan: customer\n              Context:\n                Source: \"customer\" AS \"customer\"\n              Projections:\n        - Scan: lineitem\n          Context:\n            Source: \"lineitem_2\" AS \"lineitem\"\n          Projections:\n          Dependencies:\n          - Join: lineitem_2\n            Context:\n              Source: lineitem\n            Projections:\n              - \"lineitem\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"lineitem\".\"l_suppkey\" AS \"l_suppkey\"\n              - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n              - \"lineitem\".\"l_discount\" AS \"l_discount\"\n              - \"lineitem\".\"l_shipdate\" AS \"l_shipdate\"\n            Condition: CAST(\"lineitem\".\"l_shipdate\" AS DATE) <= CAST('1996-12-31' AS DATE) AND CAST(\"lineitem\".\"l_shipdate\" AS DATE) >= CAST('1995-01-01' AS DATE)\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n        - Scan: n1\n          Context:\n            Source: \"n1\" AS \"n1\"\n          Projections:\n          Dependencies:\n          - Join: n1\n            Context:\n              Source: n1\n            Projections:\n              - \"n1\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"n1\".\"n_name\" AS \"n_name\"\n            Condition: \"n1\".\"n_name\" = 'FRANCE' OR \"n1\".\"n_name\" = 'GERMANY'\n            Dependencies:\n            - Scan: n1\n              Context:\n                Source: \"nation\" AS \"n1\"\n              Projections:\n        - Scan: n2\n          Context:\n            Source: \"n2\" AS \"n2\"\n          Projections:\n          Dependencies:\n          - Join: n2\n            Context:\n              Source: n2\n            Projections:\n              - \"n2\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"n2\".\"n_name\" AS \"n_name\"\n            Condition: \"n2\".\"n_name\" = 'FRANCE' OR \"n2\".\"n_name\" = 'GERMANY'\n            Dependencies:\n            - Scan: n2\n              Context:\n                Source: \"nation\" AS \"n2\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_custkey\" AS \"o_custkey\"\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:\n        - Scan: supplier\n          Context:\n            Source: \"supplier_2\" AS \"supplier\"\n          Projections:\n          Dependencies:\n          - Join: supplier_2\n            Context:\n              Source: supplier\n            Projections:\n              - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n              - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n            Dependencies:\n            - Scan: supplier\n              Context:\n                Source: \"supplier\" AS \"supplier\"\n              Projections:",
  "tpch",
  "select\n        o_year,\n        sum(case\n                when nation = 'BRAZIL' then volume\n                else 0\n        end) / sum(volume) as mkt_share\nfrom\n        (\n                select\n                        extract(YEAR from cast(o_orderdate as date)) as o_year,\n                        l_extendedprice * (1 - l_discount) as volume,\n                        n2.n_name as nation\n                from\n                        part,\n                        supplier,\n                        lineitem,\n                        orders,\n                        customer,\n                        nation n1,\n                        nation n2,\n                        region\n                where\n                        p_partkey = l_partkey\n                        and s_suppkey = l_suppkey\n                        and l_orderkey = o_orderkey\n                        and o_custkey = c_custkey\n                        and c_nationkey = n1.n_nationkey\n                        and n1.n_regionkey = r_regionkey\n                        and r_name = 'AMERICA'\n                        and s_nationkey = n2.n_nationkey\n                        and CAST(o_orderdate AS DATE) between date '1995-01-01' and date '1996-12-31'\n                        and p_type = 'ECONOMY ANODIZED STEEL'\n        ) as all_nations\ngroup by\n        o_year\norder by\n        o_year",
  "- Sort: part\n    Context:\n      Key:\n        - \"o_year\"\n    Projections:\n      - part._g0 AS \"o_year\"\n      - \"part\".\"mkt_share\"\n    Dependencies:\n    - Aggregate: part\n      Context:\n        Aggregations:\n          - SUM(\"_a_0\") / SUM(\"_a_1\") AS \"mkt_share\"\n        Group:\n          - EXTRACT(YEAR FROM CAST(\"orders\".\"o_orderdate\" AS DATE))\n        Operands:\n          - CASE WHEN \"n2\".\"n_name\" = 'BRAZIL' THEN \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") ELSE 0 END AS _a_0\n          - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_1\n      Projections:\n      Dependencies:\n      - Join: part\n        Context:\n          Source: part\n          lineitem: INNER\n          Key: \"lineitem\".\"l_partkey\"\n          On: TRUE AND TRUE\n          orders: INNER\n          Key: \"orders\".\"o_orderkey\"\n          On: TRUE AND TRUE\n          supplier: INNER\n          Key: \"supplier\".\"s_suppkey\"\n          On: TRUE AND TRUE\n          customer: INNER\n          Key: \"customer\".\"c_custkey\"\n          On: TRUE AND TRUE\n          n2: INNER\n          Key: \"n2\".\"n_nationkey\"\n          On: TRUE AND TRUE\n          n1: INNER\n          Key: \"n1\".\"n_nationkey\"\n          On: TRUE AND TRUE\n          region: INNER\n          Key: \"region\".\"r_regionkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Dependencies:\n        - Scan: customer\n          Context:\n            Source: \"customer_2\" AS \"customer\"\n          Projections:\n          Dependencies:\n          - Join: customer_2\n            Context:\n              Source: customer\n            Projections:\n              - \"customer\".\"c_custkey\" AS \"c_custkey\"\n              - \"customer\".\"c_nationkey\" AS \"c_nationkey\"\n            Dependencies:\n            - Scan: customer\n              Context:\n                Source: \"customer\" AS \"customer\"\n              Projections:\n        - Scan: lineitem\n          Context:\n            Source: \"lineitem_2\" AS \"lineitem\"\n          Projections:\n          Dependencies:\n          - Join: lineitem_2\n            Context:\n              Source: lineitem\n            Projections:\n              - \"lineitem\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"lineitem\".\"l_partkey\" AS \"l_partkey\"\n              - \"lineitem\".\"l_suppkey\" AS \"l_suppkey\"\n              - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n              - \"lineitem\".\"l_discount\" AS \"l_discount\"\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n        - Scan: n1\n          Context:\n            Source: \"n1\" AS \"n1\"\n          Projections:\n          Dependencies:\n          - Join: n1\n            Context:\n              Source: n1\n            Projections:\n              - \"n1\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"n1\".\"n_regionkey\" AS \"n_regionkey\"\n            Dependencies:\n            - Scan: n1\n              Context:\n                Source: \"nation\" AS \"n1\"\n              Projections:\n        - Scan: n2\n          Context:\n            Source: \"n2\" AS \"n2\"\n          Projections:\n          Dependencies:\n          - Join: n2\n            Context:\n              Source: n2\n            Projections:\n              - \"n2\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"n2\".\"n_name\" AS \"n_name\"\n            Dependencies:\n            - Scan: n2\n              Context:\n                Source: \"nation\" AS \"n2\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_custkey\" AS \"o_custkey\"\n              - \"orders\".\"o_orderdate\" AS \"o_orderdate\"\n            Condition: CAST(\"orders\".\"o_orderdate\" AS DATE) <= CAST('1996-12-31' AS DATE) AND CAST(\"orders\".\"o_orderdate\" AS DATE) >= CAST('1995-01-01' AS DATE)\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:\n        - Scan: part\n          Context:\n            Source: \"part_2\" AS \"part\"\n          Projections:\n          Dependencies:\n          - Join: part_2\n            Context:\n              Source: part\n            Projections:\n              - \"part\".\"p_partkey\" AS \"p_partkey\"\n              - \"part\".\"p_type\" AS \"p_type\"\n            Condition: \"part\".\"p_type\" = 'ECONOMY ANODIZED STEEL'\n            Dependencies:\n            - Scan: part\n              Context:\n                Source: \"part\" AS \"part\"\n              Projections:\n        - Scan: region\n          Context:\n            Source: \"region_2\" AS \"region\"\n          Projections:\n          Dependencies:\n          - Join: region_2\n            Context:\n              Source: region\n            Projections:\n              - \"region\".\"r_regionkey\" AS \"r_regionkey\"\n              - \"region\".\"r_name\" AS \"r_name\"\n            Condition: \"region\".\"r_name\" = 'AMERICA'\n            Dependencies:\n            - Scan: region\n              Context:\n                Source: \"region\" AS \"region\"\n              Projections:\n        - Scan: supplier\n          Context:\n            Source: \"supplier_2\" AS \"supplier\"\n          Projections:\n          Dependencies:\n          - Join: supplier_2\n            Context:\n              Source: supplier\n            Projections:\n              - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n              - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n            Dependencies:\n            - Scan: supplier\n              Context:\n                Source: \"supplier\" AS \"supplier\"\n              Projections:",
  "tpch",
  "select\n        nation,\n        o_year,\n        sum(amount) as sum_profit\nfrom\n        (\n                select\n                        n_name as nation,\n                        extract(year from cast(o_orderdate as date)) as o_year,\n                        l_extendedprice * (1 - l_discount) - ps_supplycost * l_quantity as amount\n                from\n                        part,\n                        supplier,\n                        lineitem,\n                        partsupp,\n                        orders,\n                        nation\n                where\n                        s_suppkey = l_suppkey\n                        and ps_suppkey = l_suppkey\n                        and ps_partkey = l_partkey\n                        and p_partkey = l_partkey\n                        and o_orderkey = l_orderkey\n                        and s_nationkey = n_nationkey\n                        and p_name like '%green%'\n        ) as profit\ngroup by\n        nation,\n        o_year\norder by\n        nation,\n        o_year desc",
  "- Sort: part\n    Context:\n      Key:\n        - \"nation\"\n        - \"o_year\" DESC\n    Projections:\n      - part._g0 AS \"nation\"\n      - part._g1 AS \"o_year\"\n      - \"part\".\"sum_profit\"\n    Dependencies:\n    - Aggregate: part\n      Context:\n        Aggregations:\n          - SUM(\"_a_0\") AS \"sum_profit\"\n        Group:\n          - \"nation\".\"n_name\"\n          - EXTRACT(YEAR FROM CAST(\"orders\".\"o_orderdate\" AS DATE))\n        Operands:\n          - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") - \"partsupp\".\"ps_supplycost\" * \"lineitem\".\"l_quantity\" AS _a_0\n      Projections:\n      Dependencies:\n      - Join: part\n        Context:\n          Source: part\n          lineitem: INNER\n          Key: \"lineitem\".\"l_partkey\"\n          On: TRUE AND TRUE\n          orders: INNER\n          Key: \"orders\".\"o_orderkey\"\n          On: TRUE AND TRUE\n          partsupp: INNER\n          Key: \"partsupp\".\"ps_partkey\", \"partsupp\".\"ps_suppkey\"\n          On: TRUE AND TRUE\n          supplier: INNER\n          Key: \"supplier\".\"s_suppkey\"\n          On: TRUE AND TRUE\n          nation: INNER\n          Key: \"nation\".\"n_nationkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Dependencies:\n        - Scan: lineitem\n          Context:\n            Source: \"lineitem_2\" AS \"lineitem\"\n          Projections:\n          Dependencies:\n          - Join: lineitem_2\n            Context:\n              Source: lineitem\n            Projections:\n              - \"lineitem\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"lineitem\".\"l_partkey\" AS \"l_partkey\"\n              - \"lineitem\".\"l_suppkey\" AS \"l_suppkey\"\n              - \"lineitem\".\"l_quantity\" AS \"l_quantity\"\n              - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n              - \"lineitem\".\"l_discount\" AS \"l_discount\"\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n        - Scan: nation\n          Context:\n            Source: \"nation_2\" AS \"nation\"\n          Projections:\n          Dependencies:\n          - Join: nation_2\n            Context:\n              Source: nation\n            Projections:\n              - \"nation\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"nation\".\"n_name\" AS \"n_name\"\n            Dependencies:\n            - Scan: nation\n              Context:\n                Source: \"nation\" AS \"nation\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_orderdate\" AS \"o_orderdate\"\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:\n        - Scan: part\n          Context:\n            Source: \"part_2\" AS \"part\"\n          Projections:\n          Dependencies:\n          - Join: part_2\n            Context:\n              Source: part\n            Projections:\n              - \"part\".\"p_partkey\" AS \"p_partkey\"\n              - \"part\".\"p_name\" AS \"p_name\"\n            Condition: \"part\".\"p_name\" LIKE '%green%'\n            Dependencies:\n            - Scan: part\n              Context:\n                Source: \"part\" AS \"part\"\n              Projections:\n        - Scan: partsupp\n          Context:\n            Source: \"partsupp_2\" AS \"partsupp\"\n          Projections:\n          Dependencies:\n          - Join: partsupp_2\n            Context:\n              Source: partsupp\n            Projections:\n              - \"partsupp\".\"ps_partkey\" AS \"ps_partkey\"\n              - \"partsupp\".\"ps_suppkey\" AS \"ps_suppkey\"\n              - \"partsupp\".\"ps_supplycost\" AS \"ps_supplycost\"\n            Dependencies:\n            - Scan: partsupp\n              Context:\n                Source: \"partsupp\" AS \"partsupp\"\n              Projections:\n        - Scan: supplier\n          Context:\n            Source: \"supplier_2\" AS \"supplier\"\n          Projections:\n          Dependencies:\n          - Join: supplier_2\n            Context:\n              Source: supplier\n            Projections:\n              - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n              - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n            Dependencies:\n            - Scan: supplier\n              Context:\n                Source: \"supplier\" AS \"supplier\"\n              Projections:",
  "tpch",
  "select\n        c_custkey,\n        c_name,\n        sum(l_extendedprice * (1 - l_discount)) as revenue,\n        c_acctbal,\n        n_name,\n        c_address,\n        c_phone,\n        c_comment\nfrom\n        customer,\n        orders,\n        lineitem,\n        nation\nwhere\n        c_custkey = o_custkey\n        and l_orderkey = o_orderkey\n        and CAST(o_orderdate AS DATE) >= date '1993-10-01'\n        and CAST(o_orderdate AS DATE) < date '1993-10-01' + interval '3' month\n        and l_returnflag = 'R'\n        and c_nationkey = n_nationkey\ngroup by\n        c_custkey,\n        c_name,\n        c_acctbal,\n        c_phone,\n        n_name,\n        c_address,\n        c_comment\norder by\n        revenue desc\nlimit\n        20",
  "- Sort: customer\n    Context:\n      Key:\n        - \"revenue\" DESC\n    Projections:\n      - customer._g0 AS \"c_custkey\"\n      - customer._g1 AS \"c_name\"\n      - \"customer\".\"revenue\"\n      - customer._g2 AS \"c_acctbal\"\n      - customer._g4 AS \"n_name\"\n      - customer._g5 AS \"c_address\"\n      - customer._g3 AS \"c_phone\"\n      - customer._g6 AS \"c_comment\"\n    Limit: 20\n    Dependencies:\n    - Aggregate: customer\n      Context:\n        Aggregations:\n          - SUM(\"_a_0\") AS \"revenue\"\n        Group:\n          - \"customer\".\"c_custkey\"\n          - \"customer\".\"c_name\"\n          - \"customer\".\"c_acctbal\"\n          - \"customer\".\"c_phone\"\n          - \"nation\".\"n_name\"\n          - \"customer\".\"c_address\"\n          - \"customer\".\"c_comment\"\n        Operands:\n          - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_0\n      Projections:\n      Dependencies:\n      - Join: customer\n        Context:\n          Source: customer\n          nation: INNER\n          Key: \"nation\".\"n_nationkey\"\n          On: TRUE AND TRUE\n          orders: INNER\n          Key: \"orders\".\"o_custkey\"\n          On: TRUE AND TRUE\n          lineitem: INNER\n          Key: \"lineitem\".\"l_orderkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Dependencies:\n        - Scan: customer\n          Context:\n            Source: \"customer_2\" AS \"customer\"\n          Projections:\n          Dependencies:\n          - Join: customer_2\n            Context:\n              Source: customer\n            Projections:\n              - \"customer\".\"c_custkey\" AS \"c_custkey\"\n              - \"customer\".\"c_name\" AS \"c_name\"\n              - \"customer\".\"c_address\" AS \"c_address\"\n              - \"customer\".\"c_nationkey\" AS \"c_nationkey\"\n              - \"customer\".\"c_phone\" AS \"c_phone\"\n              - \"customer\".\"c_acctbal\" AS \"c_acctbal\"\n              - \"customer\".\"c_comment\" AS \"c_comment\"\n            Dependencies:\n            - Scan: customer\n              Context:\n                Source: \"customer\" AS \"customer\"\n              Projections:\n        - Scan: lineitem\n          Context:\n            Source: \"lineitem_2\" AS \"lineitem\"\n          Projections:\n          Dependencies:\n          - Join: lineitem_2\n            Context:\n              Source: lineitem\n            Projections:\n              - \"lineitem\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n              - \"lineitem\".\"l_discount\" AS \"l_discount\"\n              - \"lineitem\".\"l_returnflag\" AS \"l_returnflag\"\n            Condition: \"lineitem\".\"l_returnflag\" = 'R'\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n        - Scan: nation\n          Context:\n            Source: \"nation_2\" AS \"nation\"\n          Projections:\n          Dependencies:\n          - Join: nation_2\n            Context:\n              Source: nation\n            Projections:\n              - \"nation\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"nation\".\"n_name\" AS \"n_name\"\n            Dependencies:\n            - Scan: nation\n              Context:\n                Source: \"nation\" AS \"nation\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_custkey\" AS \"o_custkey\"\n              - \"orders\".\"o_orderdate\" AS \"o_orderdate\"\n            Condition: CAST(\"orders\".\"o_orderdate\" AS DATE) < CAST('1994-01-01' AS DATE) AND CAST(\"orders\".\"o_orderdate\" AS DATE) >= CAST('1993-10-01' AS DATE)\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:",
  "tpch",
  "select\n        ps_partkey,\n        sum(ps_supplycost * ps_availqty) as value\nfrom\n        partsupp,\n        supplier,\n        nation\nwhere\n        ps_suppkey = s_suppkey\n        and s_nationkey = n_nationkey\n        and n_name = 'GERMANY'\ngroup by\n        ps_partkey having\n                sum(ps_supplycost * ps_availqty) > (\n                        select\n                                sum(ps_supplycost * ps_availqty) * 0.0001\n                        from\n                                partsupp,\n                                supplier,\n                                nation\n                        where\n                                ps_suppkey = s_suppkey\n                                and s_nationkey = n_nationkey\n                                and n_name = 'GERMANY'\n                )\norder by\n        value desc",
  "- Sort: partsupp\n    Context:\n      Key:\n        - \"value\" DESC\n    Projections:\n      - partsupp._g0 AS \"ps_partkey\"\n      - \"partsupp\".\"value\"\n    Dependencies:\n    - Aggregate: partsupp\n      Context:\n        Aggregations:\n          - SUM(\"_a_0\") AS \"value\"\n          - MAX(\"_u_0\".\"_col_0\") < SUM(\"_a_0\") AS \"_h\"\n        Group:\n          - \"partsupp\".\"ps_partkey\"\n        Having:\n          - \"partsupp\".\"_h\"\n        Operands:\n          - \"partsupp\".\"ps_supplycost\" * \"partsupp\".\"ps_availqty\" AS _a_0\n      Projections:\n      Condition: \"partsupp\".\"_h\"\n      Dependencies:\n      - Join: partsupp\n        Context:\n          Source: partsupp\n          _u_0: INNER\n          On: TRUE AND TRUE\n          supplier: INNER\n          Key: \"supplier\".\"s_suppkey\"\n          On: TRUE AND TRUE\n          nation: INNER\n          Key: \"nation\".\"n_nationkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Dependencies:\n        - Scan: _u_0\n          Context:\n            Source: \"_u_0\" AS \"_u_0\"\n          Projections:\n          Dependencies:\n          - Aggregate: _u_0\n            Context:\n              Aggregations:\n                - SUM(\"_a_0\") * 0.0001 AS \"_col_0\"\n              Operands:\n                - \"partsupp\".\"ps_supplycost\" * \"partsupp\".\"ps_availqty\" AS _a_0\n            Projections:\n              - \"partsupp\".\"_col_0\"\n            Dependencies:\n            - Join: partsupp\n              Context:\n                Source: partsupp\n                supplier: INNER\n                Key: \"supplier\".\"s_suppkey\"\n                On: TRUE AND TRUE\n                nation: INNER\n                Key: \"nation\".\"n_nationkey\"\n                On: TRUE AND TRUE\n              Projections:\n              Dependencies:\n              - Scan: nation\n                Context:\n                  Source: \"nation_2\" AS \"nation\"\n                Projections:\n                Dependencies:\n                - Join: nation_2\n                  Context:\n                    Source: nation\n                  Projections:\n                    - \"nation\".\"n_nationkey\" AS \"n_nationkey\"\n                    - \"nation\".\"n_name\" AS \"n_name\"\n                  Condition: \"nation\".\"n_name\" = 'GERMANY'\n                  Dependencies:\n                  - Scan: nation\n                    Context:\n                      Source: \"nation\" AS \"nation\"\n                    Projections:\n              - Scan: partsupp\n                Context:\n                  Source: \"partsupp_3\" AS \"partsupp\"\n                Projections:\n                Dependencies:\n                - Join: partsupp_3\n                  Context:\n                    Source: partsupp\n                  Projections:\n                    - \"partsupp\".\"ps_suppkey\" AS \"ps_suppkey\"\n                    - \"partsupp\".\"ps_availqty\" AS \"ps_availqty\"\n                    - \"partsupp\".\"ps_supplycost\" AS \"ps_supplycost\"\n                  Dependencies:\n                  - Scan: partsupp\n                    Context:\n                      Source: \"partsupp\" AS \"partsupp\"\n                    Projections:\n              - Scan: supplier\n                Context:\n                  Source: \"supplier_2\" AS \"supplier\"\n                Projections:\n                Dependencies:\n                - Join: supplier_2\n                  Context:\n                    Source: supplier\n                  Projections:\n                    - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n                    - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n                  Dependencies:\n                  - Scan: supplier\n                    Context:\n                      Source: \"supplier\" AS \"supplier\"\n                    Projections:\n        - Scan: nation\n          Context:\n            Source: \"nation_2\" AS \"nation\"\n          Projections:\n          Dependencies:\n          - Join: nation_2\n            Context:\n              Source: nation\n            Projections:\n              - \"nation\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"nation\".\"n_name\" AS \"n_name\"\n            Condition: \"nation\".\"n_name\" = 'GERMANY'\n            Dependencies:\n            - Scan: nation\n              Context:\n                Source: \"nation\" AS \"nation\"\n              Projections:\n        - Scan: partsupp\n          Context:\n            Source: \"partsupp_2\" AS \"partsupp\"\n          Projections:\n          Dependencies:\n          - Join: partsupp_2\n            Context:\n              Source: partsupp\n            Projections:\n              - \"partsupp\".\"ps_partkey\" AS \"ps_partkey\"\n              - \"partsupp\".\"ps_suppkey\" AS \"ps_suppkey\"\n              - \"partsupp\".\"ps_availqty\" AS \"ps_availqty\"\n              - \"partsupp\".\"ps_supplycost\" AS \"ps_supplycost\"\n            Dependencies:\n            - Scan: partsupp\n              Context:\n                Source: \"partsupp\" AS \"partsupp\"\n              Projections:\n        - Scan: supplier\n          Context:\n            Source: \"supplier_2\" AS \"supplier\"\n          Projections:\n          Dependencies:\n          - Join: supplier_2\n            Context:\n              Source: supplier\n            Projections:\n              - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n              - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n            Dependencies:\n            - Scan: supplier\n              Context:\n                Source: \"supplier\" AS \"supplier\"\n              Projections:",
  "tpch",
  "select\n        l_shipmode,\n        sum(case\n                when o_orderpriority = '1-URGENT'\n                        or o_orderpriority = '2-HIGH'\n                        then 1\n                else 0\n        end) as high_line_count,\n        sum(case\n                when o_orderpriority <> '1-URGENT'\n                        and o_orderpriority <> '2-HIGH'\n                        then 1\n                else 0\n        end) as low_line_count\nfrom\n        orders,\n        lineitem\nwhere\n        o_orderkey = l_orderkey\n        and l_shipmode in ('MAIL', 'SHIP')\n        and l_commitdate < l_receiptdate\n        and l_shipdate < l_commitdate\n        and CAST(l_receiptdate AS DATE) >= date '1994-01-01'\n        and CAST(l_receiptdate AS DATE) < date '1994-01-01' + interval '1' year\ngroup by\n        l_shipmode\norder by\n        l_shipmode",
  "- Sort: orders\n    Context:\n      Key:\n        - \"l_shipmode\"\n    Projections:\n      - orders._g0 AS \"l_shipmode\"\n      - \"orders\".\"high_line_count\"\n      - \"orders\".\"low_line_count\"\n    Dependencies:\n    - Aggregate: orders\n      Context:\n        Aggregations:\n          - SUM(\"_a_0\") AS \"high_line_count\"\n          - SUM(\"_a_1\") AS \"low_line_count\"\n        Group:\n          - \"lineitem\".\"l_shipmode\"\n        Operands:\n          - CASE WHEN \"orders\".\"o_orderpriority\" = '1-URGENT' OR \"orders\".\"o_orderpriority\" = '2-HIGH' THEN 1 ELSE 0 END AS _a_0\n          - CASE WHEN \"orders\".\"o_orderpriority\" <> '1-URGENT' AND \"orders\".\"o_orderpriority\" <> '2-HIGH' THEN 1 ELSE 0 END AS _a_1\n      Projections:\n      Dependencies:\n      - Join: orders\n        Context:\n          Source: orders\n          lineitem: INNER\n          Key: \"lineitem\".\"l_orderkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Dependencies:\n        - Scan: lineitem\n          Context:\n            Source: \"lineitem_2\" AS \"lineitem\"\n          Projections:\n          Dependencies:\n          - Join: lineitem_2\n            Context:\n              Source: lineitem\n            Projections:\n              - \"lineitem\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"lineitem\".\"l_shipdate\" AS \"l_shipdate\"\n              - \"lineitem\".\"l_commitdate\" AS \"l_commitdate\"\n              - \"lineitem\".\"l_receiptdate\" AS \"l_receiptdate\"\n              - \"lineitem\".\"l_shipmode\" AS \"l_shipmode\"\n            Condition: \"lineitem\".\"l_commitdate\" < \"lineitem\".\"l_receiptdate\" AND \"lineitem\".\"l_commitdate\" > \"lineitem\".\"l_shipdate\" AND \"lineitem\".\"l_shipmode\" IN ('MAIL', 'SHIP') AND CAST(\"lineitem\".\"l_receiptdate\" AS DATE) < CAST('1995-01-01' AS DATE) AND CAST(\"lineitem\".\"l_receiptdate\" AS DATE) >= CAST('1994-01-01' AS DATE)\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_orderpriority\" AS \"o_orderpriority\"\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:",
  "tpch",
  "select\n        c_count,\n        count(*) as custdist\nfrom\n        (\n                select\n                        c_custkey,\n                        count(o_orderkey)\n                from\n                        customer left outer join orders on\n                                c_custkey = o_custkey\n                                and o_comment not like '%special%requests%'\n                group by\n                        c_custkey\n        ) as c_orders (c_custkey, c_count)\ngroup by\n        c_count\norder by\n        custdist desc,\n        c_count desc",
  "- Sort: c_orders\n    Context:\n      Key:\n        - \"custdist\" DESC\n        - \"c_count\" DESC\n    Projections:\n      - c_orders._g0 AS \"c_count\"\n      - \"c_orders\".\"custdist\"\n    Dependencies:\n    - Aggregate: c_orders\n      Context:\n        Aggregations:\n          - COUNT(\"_a_0\") AS \"custdist\"\n        Group:\n          - \"c_orders\".\"c_count\"\n        Operands:\n          - * AS _a_0\n      Projections:\n      Dependencies:\n      - Join: c_orders\n        Context:\n          Source: c_orders\n        Projections:\n        Dependencies:\n        - Scan: c_orders\n          Context:\n            Source: \"c_orders\" AS \"c_orders\"\n          Projections:\n          Dependencies:\n          - Aggregate: c_orders\n            Context:\n              Aggregations:\n                - COUNT(\"orders\".\"o_orderkey\") AS \"c_count\"\n              Group:\n                - \"customer\".\"c_custkey\"\n            Projections:\n              - \"customer\".\"c_count\"\n            Dependencies:\n            - Join: customer\n              Context:\n                Source: customer\n                orders: LEFT\n                Key: \"orders\".\"o_custkey\"\n                On: TRUE AND TRUE\n              Projections:\n              Dependencies:\n              - Scan: customer\n                Context:\n                  Source: \"customer_2\" AS \"customer\"\n                Projections:\n                Dependencies:\n                - Join: customer_2\n                  Context:\n                    Source: customer\n                  Projections:\n                    - \"customer\".\"c_custkey\" AS \"c_custkey\"\n                  Dependencies:\n                  - Scan: customer\n                    Context:\n                      Source: \"customer\" AS \"customer\"\n                    Projections:\n              - Scan: orders\n                Context:\n                  Source: \"orders_2\" AS \"orders\"\n                Projections:\n                Dependencies:\n                - Join: orders_2\n                  Context:\n                    Source: orders\n                  Projections:\n                    - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n                    - \"orders\".\"o_custkey\" AS \"o_custkey\"\n                    - \"orders\".\"o_comment\" AS \"o_comment\"\n                  Condition: \"orders\".\"o_comment\" NOT LIKE '%special%requests%'\n                  Dependencies:\n                  - Scan: orders\n                    Context:\n                      Source: \"orders\" AS \"orders\"\n                    Projections:",
  "tpch",
  "select\n        100.00 * sum(case\n                when p_type like 'PROMO%'\n                        then l_extendedprice * (1 - l_discount)\n                else 0\n        end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue\nfrom\n        lineitem,\n        part\nwhere\n        l_partkey = p_partkey\n        and CAST(l_shipdate AS DATE) >= date '1995-09-01'\n        and CAST(l_shipdate AS DATE) < date '1995-09-01' + interval '1' month",
  "- Aggregate: lineitem\n    Context:\n      Aggregations:\n        - 100.00 * SUM(\"_a_0\") / SUM(\"_a_1\") AS \"promo_revenue\"\n      Operands:\n        - CASE WHEN \"part\".\"p_type\" LIKE 'PROMO%' THEN \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") ELSE 0 END AS _a_0\n        - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_1\n    Projections:\n      - \"lineitem\".\"promo_revenue\"\n    Dependencies:\n    - Join: lineitem\n      Context:\n        Source: lineitem\n        part: INNER\n        Key: \"part\".\"p_partkey\"\n        On: TRUE AND TRUE\n      Projections:\n      Dependencies:\n      - Scan: lineitem\n        Context:\n          Source: \"lineitem_2\" AS \"lineitem\"\n        Projections:\n        Dependencies:\n        - Join: lineitem_2\n          Context:\n            Source: lineitem\n          Projections:\n            - \"lineitem\".\"l_partkey\" AS \"l_partkey\"\n            - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n            - \"lineitem\".\"l_discount\" AS \"l_discount\"\n            - \"lineitem\".\"l_shipdate\" AS \"l_shipdate\"\n          Condition: CAST(\"lineitem\".\"l_shipdate\" AS DATE) < CAST('1995-10-01' AS DATE) AND CAST(\"lineitem\".\"l_shipdate\" AS DATE) >= CAST('1995-09-01' AS DATE)\n          Dependencies:\n          - Scan: lineitem\n            Context:\n              Source: \"lineitem\" AS \"lineitem\"\n            Projections:\n      - Scan: part\n        Context:\n          Source: \"part_2\" AS \"part\"\n        Projections:\n        Dependencies:\n        - Join: part_2\n          Context:\n            Source: part\n          Projections:\n            - \"part\".\"p_partkey\" AS \"p_partkey\"\n            - \"part\".\"p_type\" AS \"p_type\"\n          Dependencies:\n          - Scan: part\n            Context:\n              Source: \"part\" AS \"part\"\n            Projections:",
  "tpch",
  "with revenue (supplier_no, total_revenue) as (\n        select\n                l_suppkey,\n                sum(l_extendedprice * (1 - l_discount))\n        from\n                lineitem\n        where\n                CAST(l_shipdate AS DATE) >= date '1996-01-01'\n                and CAST(l_shipdate AS DATE) < date '1996-01-01' + interval '3' month\n        group by\n                l_suppkey)\nselect\n        s_suppkey,\n        s_name,\n        s_address,\n        s_phone,\n        total_revenue\nfrom\n        supplier,\n        revenue\nwhere\n        s_suppkey = supplier_no\n        and total_revenue = (\n                select\n                        max(total_revenue)\n                from\n                        revenue\n        )\norder by\n        s_suppkey",
  "- Sort: supplier\n    Context:\n      Key:\n        - \"s_suppkey\"\n    Projections:\n      - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n      - \"supplier\".\"s_name\" AS \"s_name\"\n      - \"supplier\".\"s_address\" AS \"s_address\"\n      - \"supplier\".\"s_phone\" AS \"s_phone\"\n      - \"revenue\".\"total_revenue\" AS \"total_revenue\"\n    Dependencies:\n    - Join: supplier\n      Context:\n        Source: supplier\n        revenue: INNER\n        Key: \"revenue\".\"supplier_no\"\n        On: TRUE AND TRUE\n        _u_0: INNER\n        Key: \"_u_0\".\"_col_0\"\n        On: TRUE AND TRUE\n      Projections:\n      Dependencies:\n      - Scan: _u_0\n        Context:\n          Source: \"_u_0\" AS \"_u_0\"\n        Projections:\n        Dependencies:\n        - Aggregate: _u_0\n          Context:\n            Aggregations:\n              - MAX(\"revenue\".\"total_revenue\") AS \"_col_0\"\n          Projections:\n            - \"revenue\".\"_col_0\"\n          Dependencies:\n          - Join: revenue\n            Context:\n              Source: revenue\n            Projections:\n            Dependencies:\n            - Scan: revenue\n              Context:\n                Source: \"revenue\" AS \"revenue\"\n              Projections:\n              Dependencies:\n              - Aggregate: revenue\n                Context:\n                  Aggregations:\n                    - SUM(\"_a_0\") AS \"total_revenue\"\n                  Group:\n                    - \"lineitem\".\"l_suppkey\"\n                  Operands:\n                    - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_0\n                Projections:\n                  - lineitem._g0 AS \"supplier_no\"\n                  - \"lineitem\".\"total_revenue\"\n                Dependencies:\n                - Join: lineitem\n                  Context:\n                    Source: lineitem\n                  Projections:\n                  Condition: CAST(\"lineitem\".\"l_shipdate\" AS DATE) < CAST('1996-04-01' AS DATE) AND CAST(\"lineitem\".\"l_shipdate\" AS DATE) >= CAST('1996-01-01' AS DATE)\n                  Dependencies:\n                  - Scan: lineitem\n                    Context:\n                      Source: \"lineitem\" AS \"lineitem\"\n                    Projections:\n      - Scan: revenue\n        Context:\n          Source: \"revenue\" AS \"revenue\"\n        Projections:\n        Dependencies:\n        - Aggregate: revenue\n          Context:\n            Aggregations:\n              - SUM(\"_a_0\") AS \"total_revenue\"\n            Group:\n              - \"lineitem\".\"l_suppkey\"\n            Operands:\n              - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_0\n          Projections:\n            - lineitem._g0 AS \"supplier_no\"\n            - \"lineitem\".\"total_revenue\"\n          Dependencies:\n          - Join: lineitem\n            Context:\n              Source: lineitem\n            Projections:\n            Condition: CAST(\"lineitem\".\"l_shipdate\" AS DATE) < CAST('1996-04-01' AS DATE) AND CAST(\"lineitem\".\"l_shipdate\" AS DATE) >= CAST('1996-01-01' AS DATE)\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n      - Scan: supplier\n        Context:\n          Source: \"supplier_2\" AS \"supplier\"\n        Projections:\n        Dependencies:\n        - Join: supplier_2\n          Context:\n            Source: supplier\n          Projections:\n            - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n            - \"supplier\".\"s_name\" AS \"s_name\"\n            - \"supplier\".\"s_address\" AS \"s_address\"\n            - \"supplier\".\"s_phone\" AS \"s_phone\"\n          Dependencies:\n          - Scan: supplier\n            Context:\n              Source: \"supplier\" AS \"supplier\"\n            Projections:",
  "tpch",
  "select\n        p_brand,\n        p_type,\n        p_size,\n        count(distinct ps_suppkey) as supplier_cnt\nfrom\n        partsupp,\n        part\nwhere\n        p_partkey = ps_partkey\n        and p_brand <> 'Brand#45'\n        and p_type not like 'MEDIUM POLISHED%'\n        and p_size in (49, 14, 23, 45, 19, 3, 36, 9)\n        and ps_suppkey not in (\n                select\n                        s_suppkey\n                from\n                        supplier\n                where\n                        s_comment like '%Customer%Complaints%'\n        )\ngroup by\n        p_brand,\n        p_type,\n        p_size\norder by\n        supplier_cnt desc,\n        p_brand,\n        p_type,\n        p_size",
  "- Sort: partsupp\n    Context:\n      Key:\n        - \"supplier_cnt\" DESC\n        - \"p_brand\"\n        - \"p_type\"\n        - \"p_size\"\n    Projections:\n      - partsupp._g0 AS \"p_brand\"\n      - partsupp._g1 AS \"p_type\"\n      - partsupp._g2 AS \"p_size\"\n      - \"partsupp\".\"supplier_cnt\"\n    Dependencies:\n    - Aggregate: partsupp\n      Context:\n        Aggregations:\n          - COUNT(DISTINCT \"partsupp\".\"ps_suppkey\") AS \"supplier_cnt\"\n        Group:\n          - \"part\".\"p_brand\"\n          - \"part\".\"p_type\"\n          - \"part\".\"p_size\"\n      Projections:\n      Dependencies:\n      - Join: partsupp\n        Context:\n          Source: partsupp\n          part: INNER\n          Key: \"part\".\"p_partkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Condition: NOT \"partsupp\".\"ps_suppkey\" IN (SELECT \"supplier\".\"s_suppkey\" AS \"s_suppkey\" FROM \"supplier\" AS \"supplier\" WHERE \"supplier\".\"s_comment\" LIKE '%Customer%Complaints%')\n        Dependencies:\n        - Scan: part\n          Context:\n            Source: \"part_2\" AS \"part\"\n          Projections:\n          Dependencies:\n          - Join: part_2\n            Context:\n              Source: part\n            Projections:\n              - \"part\".\"p_partkey\" AS \"p_partkey\"\n              - \"part\".\"p_brand\" AS \"p_brand\"\n              - \"part\".\"p_type\" AS \"p_type\"\n              - \"part\".\"p_size\" AS \"p_size\"\n            Condition: \"part\".\"p_brand\" <> 'Brand#45' AND \"part\".\"p_size\" IN (49, 14, 23, 45, 19, 3, 36, 9) AND \"part\".\"p_type\" NOT LIKE 'MEDIUM POLISHED%'\n            Dependencies:\n            - Scan: part\n              Context:\n                Source: \"part\" AS \"part\"\n              Projections:\n        - Scan: partsupp\n          Context:\n            Source: \"partsupp_2\" AS \"partsupp\"\n          Projections:\n          Dependencies:\n          - Join: partsupp_2\n            Context:\n              Source: partsupp\n            Projections:\n              - \"partsupp\".\"ps_partkey\" AS \"ps_partkey\"\n              - \"partsupp\".\"ps_suppkey\" AS \"ps_suppkey\"\n            Dependencies:\n            - Scan: partsupp\n              Context:\n                Source: \"partsupp\" AS \"partsupp\"\n              Projections:",
  "tpch",
  "select\n        sum(l_extendedprice) / 7.0 as avg_yearly\nfrom\n        lineitem,\n        part\nwhere\n        p_partkey = l_partkey\n        and p_brand = 'Brand#23'\n        and p_container = 'MED BOX'\n        and l_quantity < (\n                select\n                        0.2 * avg(l_quantity)\n                from\n                        lineitem\n                where\n                        l_partkey = p_partkey\n        )",
  "- Aggregate: lineitem\n    Context:\n      Aggregations:\n        - SUM(\"lineitem\".\"l_extendedprice\") / 7.0 AS \"avg_yearly\"\n    Projections:\n      - \"lineitem\".\"avg_yearly\"\n    Dependencies:\n    - Join: lineitem\n      Context:\n        Source: lineitem\n        part: INNER\n        Key: \"part\".\"p_partkey\"\n        On: TRUE AND TRUE\n        _u_0: LEFT\n        Key: \"_u_0\".\"_u_1\"\n        On: TRUE AND TRUE\n      Projections:\n      Condition: \"_u_0\".\"_col_0\" > \"lineitem\".\"l_quantity\"\n      Dependencies:\n      - Scan: _u_0\n        Context:\n          Source: \"_u_0\" AS \"_u_0\"\n        Projections:\n        Dependencies:\n        - Aggregate: _u_0\n          Context:\n            Aggregations:\n              - 0.2 * AVG(\"lineitem\".\"l_quantity\") AS \"_col_0\"\n            Group:\n              - \"lineitem\".\"l_partkey\"\n          Projections:\n            - \"lineitem\".\"_col_0\"\n            - lineitem._g0 AS \"_u_1\"\n          Dependencies:\n          - Join: lineitem\n            Context:\n              Source: lineitem\n            Projections:\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n      - Scan: lineitem\n        Context:\n          Source: \"lineitem_2\" AS \"lineitem\"\n        Projections:\n        Dependencies:\n        - Join: lineitem_2\n          Context:\n            Source: lineitem\n          Projections:\n            - \"lineitem\".\"l_partkey\" AS \"l_partkey\"\n            - \"lineitem\".\"l_quantity\" AS \"l_quantity\"\n            - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n          Dependencies:\n          - Scan: lineitem\n            Context:\n              Source: \"lineitem\" AS \"lineitem\"\n            Projections:\n      - Scan: part\n        Context:\n          Source: \"part_2\" AS \"part\"\n        Projections:\n        Dependencies:\n        - Join: part_2\n          Context:\n            Source: part\n          Projections:\n            - \"part\".\"p_partkey\" AS \"p_partkey\"\n            - \"part\".\"p_brand\" AS \"p_brand\"\n            - \"part\".\"p_container\" AS \"p_container\"\n          Condition: \"part\".\"p_brand\" = 'Brand#23' AND \"part\".\"p_container\" = 'MED BOX'\n          Dependencies:\n          - Scan: part\n            Context:\n              Source: \"part\" AS \"part\"\n            Projections:",
  "tpch",
  "select\n        c_name,\n        c_custkey,\n        o_orderkey,\n        o_orderdate,\n        o_totalprice,\n        sum(l_quantity) total_quantity\nfrom\n        customer,\n        orders,\n        lineitem\nwhere\n        o_orderkey in (\n                select\n                        l_orderkey\n                from\n                        lineitem\n                group by\n                        l_orderkey having\n                                sum(l_quantity) > 300\n        )\n        and c_custkey = o_custkey\n        and o_orderkey = l_orderkey\ngroup by\n        c_name,\n        c_custkey,\n        o_orderkey,\n        o_orderdate,\n        o_totalprice\norder by\n        o_totalprice desc,\n        o_orderdate\nlimit\n        100",
  "- Sort: customer\n    Context:\n      Key:\n        - \"o_totalprice\" DESC\n        - \"o_orderdate\"\n    Projections:\n      - customer._g0 AS \"c_name\"\n      - customer._g1 AS \"c_custkey\"\n      - customer._g2 AS \"o_orderkey\"\n      - customer._g3 AS \"o_orderdate\"\n      - customer._g4 AS \"o_totalprice\"\n      - \"customer\".\"total_quantity\"\n    Limit: 100\n    Dependencies:\n    - Aggregate: customer\n      Context:\n        Aggregations:\n          - SUM(\"lineitem\".\"l_quantity\") AS \"total_quantity\"\n        Group:\n          - \"customer\".\"c_name\"\n          - \"customer\".\"c_custkey\"\n          - \"orders\".\"o_orderkey\"\n          - \"orders\".\"o_orderdate\"\n          - \"orders\".\"o_totalprice\"\n      Projections:\n      Dependencies:\n      - Join: customer\n        Context:\n          Source: customer\n          orders: INNER\n          Key: \"orders\".\"o_custkey\"\n          On: TRUE AND TRUE\n          lineitem: INNER\n          Key: \"lineitem\".\"l_orderkey\"\n          On: TRUE AND TRUE\n          _u_0: LEFT\n          Key: \"_u_0\".\"l_orderkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Condition: NOT \"_u_0\".\"l_orderkey\" IS NULL\n        Dependencies:\n        - Scan: _u_0\n          Context:\n            Source: \"_u_0\" AS \"_u_0\"\n          Projections:\n          Dependencies:\n          - Aggregate: _u_0\n            Context:\n              Aggregations:\n                - SUM(\"lineitem\".\"l_quantity\") > 300 AS \"_h\"\n              Group:\n                - \"lineitem\".\"l_orderkey\"\n              Having:\n                - \"lineitem\".\"_h\"\n            Projections:\n              - lineitem._g0 AS \"l_orderkey\"\n            Condition: \"lineitem\".\"_h\"\n            Dependencies:\n            - Join: lineitem\n              Context:\n                Source: lineitem\n              Projections:\n              Dependencies:\n              - Scan: lineitem\n                Context:\n                  Source: \"lineitem\" AS \"lineitem\"\n                Projections:\n        - Scan: customer\n          Context:\n            Source: \"customer_2\" AS \"customer\"\n          Projections:\n          Dependencies:\n          - Join: customer_2\n            Context:\n              Source: customer\n            Projections:\n              - \"customer\".\"c_custkey\" AS \"c_custkey\"\n              - \"customer\".\"c_name\" AS \"c_name\"\n            Dependencies:\n            - Scan: customer\n              Context:\n                Source: \"customer\" AS \"customer\"\n              Projections:\n        - Scan: lineitem\n          Context:\n            Source: \"lineitem_2\" AS \"lineitem\"\n          Projections:\n          Dependencies:\n          - Join: lineitem_2\n            Context:\n              Source: lineitem\n            Projections:\n              - \"lineitem\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"lineitem\".\"l_quantity\" AS \"l_quantity\"\n            Dependencies:\n            - Scan: lineitem\n              Context:\n                Source: \"lineitem\" AS \"lineitem\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_custkey\" AS \"o_custkey\"\n              - \"orders\".\"o_totalprice\" AS \"o_totalprice\"\n              - \"orders\".\"o_orderdate\" AS \"o_orderdate\"\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:",
  "tpch",
  "select\n        sum(l_extendedprice* (1 - l_discount)) as revenue\nfrom\n        lineitem,\n        part\nwhere\n        (\n                p_partkey = l_partkey\n                and p_brand = 'Brand#12'\n                and p_container in ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')\n                and l_quantity >= 1 and l_quantity <= 11\n                and p_size between 1 and 5\n                and l_shipmode in ('AIR', 'AIR REG')\n                and l_shipinstruct = 'DELIVER IN PERSON'\n        )\n        or\n        (\n                p_partkey = l_partkey\n                and p_brand = 'Brand#23'\n                and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')\n                and l_quantity >= 10 and l_quantity <= 20\n                and p_size between 1 and 10\n                and l_shipmode in ('AIR', 'AIR REG')\n                and l_shipinstruct = 'DELIVER IN PERSON'\n        )\n        or\n        (\n                p_partkey = l_partkey\n                and p_brand = 'Brand#34'\n                and p_container in ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')\n                and l_quantity >= 20 and l_quantity <= 30\n                and p_size between 1 and 15\n                and l_shipmode in ('AIR', 'AIR REG')\n                and l_shipinstruct = 'DELIVER IN PERSON'\n        )",
  "- Aggregate: lineitem\n    Context:\n      Aggregations:\n        - SUM(\"_a_0\") AS \"revenue\"\n      Operands:\n        - \"lineitem\".\"l_extendedprice\" * (1 - \"lineitem\".\"l_discount\") AS _a_0\n    Projections:\n      - \"lineitem\".\"revenue\"\n    Dependencies:\n    - Join: lineitem\n      Context:\n        Source: lineitem\n        part: INNER\n        Key: \"part\".\"p_partkey\", \"part\".\"p_partkey\", \"part\".\"p_partkey\"\n        On: (TRUE AND \"lineitem\".\"l_quantity\" <= 11 AND \"lineitem\".\"l_quantity\" >= 1 AND \"lineitem\".\"l_shipinstruct\" = 'DELIVER IN PERSON' AND \"lineitem\".\"l_shipmode\" IN ('AIR', 'AIR REG') AND \"part\".\"p_brand\" = 'Brand#12' AND \"part\".\"p_container\" IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG') AND \"part\".\"p_size\" <= 5 AND \"part\".\"p_size\" >= 1) OR (TRUE AND \"lineitem\".\"l_quantity\" <= 20 AND \"lineitem\".\"l_quantity\" >= 10 AND \"lineitem\".\"l_shipinstruct\" = 'DELIVER IN PERSON' AND \"lineitem\".\"l_shipmode\" IN ('AIR', 'AIR REG') AND \"part\".\"p_brand\" = 'Brand#23' AND \"part\".\"p_container\" IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK') AND \"part\".\"p_size\" <= 10 AND \"part\".\"p_size\" >= 1) OR (TRUE AND \"lineitem\".\"l_quantity\" <= 30 AND \"lineitem\".\"l_quantity\" >= 20 AND \"lineitem\".\"l_shipinstruct\" = 'DELIVER IN PERSON' AND \"lineitem\".\"l_shipmode\" IN ('AIR', 'AIR REG') AND \"part\".\"p_brand\" = 'Brand#34' AND \"part\".\"p_container\" IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG') AND \"part\".\"p_size\" <= 15 AND \"part\".\"p_size\" >= 1)\n      Projections:\n      Condition: (\"lineitem\".\"l_partkey\" = \"part\".\"p_partkey\" AND \"lineitem\".\"l_quantity\" <= 11 AND \"lineitem\".\"l_quantity\" >= 1 AND \"lineitem\".\"l_shipinstruct\" = 'DELIVER IN PERSON' AND \"lineitem\".\"l_shipmode\" IN ('AIR', 'AIR REG') AND \"part\".\"p_brand\" = 'Brand#12' AND \"part\".\"p_container\" IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG') AND \"part\".\"p_size\" <= 5 AND \"part\".\"p_size\" >= 1) OR (\"lineitem\".\"l_partkey\" = \"part\".\"p_partkey\" AND \"lineitem\".\"l_quantity\" <= 20 AND \"lineitem\".\"l_quantity\" >= 10 AND \"lineitem\".\"l_shipinstruct\" = 'DELIVER IN PERSON' AND \"lineitem\".\"l_shipmode\" IN ('AIR', 'AIR REG') AND \"part\".\"p_brand\" = 'Brand#23' AND \"part\".\"p_container\" IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK') AND \"part\".\"p_size\" <= 10 AND \"part\".\"p_size\" >= 1) OR (\"lineitem\".\"l_partkey\" = \"part\".\"p_partkey\" AND \"lineitem\".\"l_quantity\" <= 30 AND \"lineitem\".\"l_quantity\" >= 20 AND \"lineitem\".\"l_shipinstruct\" = 'DELIVER IN PERSON' AND \"lineitem\".\"l_shipmode\" IN ('AIR', 'AIR REG') AND \"part\".\"p_brand\" = 'Brand#34' AND \"part\".\"p_container\" IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG') AND \"part\".\"p_size\" <= 15 AND \"part\".\"p_size\" >= 1)\n      Dependencies:\n      - Scan: lineitem\n        Context:\n          Source: \"lineitem_2\" AS \"lineitem\"\n        Projections:\n        Dependencies:\n        - Join: lineitem_2\n          Context:\n            Source: lineitem\n          Projections:\n            - \"lineitem\".\"l_partkey\" AS \"l_partkey\"\n            - \"lineitem\".\"l_quantity\" AS \"l_quantity\"\n            - \"lineitem\".\"l_extendedprice\" AS \"l_extendedprice\"\n            - \"lineitem\".\"l_discount\" AS \"l_discount\"\n            - \"lineitem\".\"l_shipinstruct\" AS \"l_shipinstruct\"\n            - \"lineitem\".\"l_shipmode\" AS \"l_shipmode\"\n          Dependencies:\n          - Scan: lineitem\n            Context:\n              Source: \"lineitem\" AS \"lineitem\"\n            Projections:\n      - Scan: part\n        Context:\n          Source: \"part_2\" AS \"part\"\n        Projections:\n        Dependencies:\n        - Join: part_2\n          Context:\n            Source: part\n          Projections:\n            - \"part\".\"p_partkey\" AS \"p_partkey\"\n            - \"part\".\"p_brand\" AS \"p_brand\"\n            - \"part\".\"p_size\" AS \"p_size\"\n            - \"part\".\"p_container\" AS \"p_container\"\n          Dependencies:\n          - Scan: part\n            Context:\n              Source: \"part\" AS \"part\"\n            Projections:",
  "tpch",
  "select\n        s_name,\n        s_address\nfrom\n        supplier,\n        nation\nwhere\n        s_suppkey in (\n                select\n                        ps_suppkey\n                from\n                        partsupp\n                where\n                        ps_partkey in (\n                                select\n                                        p_partkey\n                                from\n                                        part\n                                where\n                                        p_name like 'forest%'\n                        )\n                        and ps_availqty > (\n                                select\n                                        0.5 * sum(l_quantity)\n                                from\n                                        lineitem\n                                where\n                                        l_partkey = ps_partkey\n                                        and l_suppkey = ps_suppkey\n                                        and CAST(l_shipdate AS DATE) >= date '1994-01-01'\n                                        and CAST(l_shipdate AS DATE) < date '1994-01-01' + interval '1' year\n                        )\n        )\n        and s_nationkey = n_nationkey\n        and n_name = 'CANADA'\norder by\n        s_name",
  "- Sort: supplier\n    Context:\n      Key:\n        - \"s_name\"\n    Projections:\n      - \"supplier\".\"s_name\" AS \"s_name\"\n      - \"supplier\".\"s_address\" AS \"s_address\"\n    Dependencies:\n    - Join: supplier\n      Context:\n        Source: supplier\n        nation: INNER\n        Key: \"nation\".\"n_nationkey\"\n        On: TRUE AND TRUE\n        _u_4: LEFT\n        Key: \"_u_4\".\"ps_suppkey\"\n        On: TRUE AND TRUE\n      Projections:\n      Condition: NOT \"_u_4\".\"ps_suppkey\" IS NULL\n      Dependencies:\n      - Scan: _u_4\n        Context:\n          Source: \"_u_4\" AS \"_u_4\"\n        Projections:\n        Dependencies:\n        - Aggregate: _u_4\n          Context:\n            Aggregations:\n            Group:\n              - \"partsupp\".\"ps_suppkey\"\n          Projections:\n            - partsupp._g0 AS \"ps_suppkey\"\n          Dependencies:\n          - Join: partsupp\n            Context:\n              Source: partsupp\n              _u_0: LEFT\n              Key: \"_u_0\".\"p_partkey\"\n              On: TRUE AND TRUE\n              _u_1: LEFT\n              Key: \"_u_1\".\"_u_2\", \"_u_1\".\"_u_3\"\n              On: TRUE AND TRUE\n            Projections:\n            Condition: \"_u_1\".\"_col_0\" < \"partsupp\".\"ps_availqty\" AND NOT \"_u_0\".\"p_partkey\" IS NULL\n            Dependencies:\n            - Scan: _u_0\n              Context:\n                Source: \"_u_0\" AS \"_u_0\"\n              Projections:\n              Dependencies:\n              - Aggregate: _u_0\n                Context:\n                  Aggregations:\n                  Group:\n                    - \"part\".\"p_partkey\"\n                Projections:\n                  - part._g0 AS \"p_partkey\"\n                Dependencies:\n                - Join: part\n                  Context:\n                    Source: part\n                  Projections:\n                  Condition: \"part\".\"p_name\" LIKE 'forest%'\n                  Dependencies:\n                  - Scan: part\n                    Context:\n                      Source: \"part\" AS \"part\"\n                    Projections:\n            - Scan: _u_1\n              Context:\n                Source: \"_u_1\" AS \"_u_1\"\n              Projections:\n              Dependencies:\n              - Aggregate: _u_1\n                Context:\n                  Aggregations:\n                    - 0.5 * SUM(\"lineitem\".\"l_quantity\") AS \"_col_0\"\n                  Group:\n                    - \"lineitem\".\"l_partkey\"\n                    - \"lineitem\".\"l_suppkey\"\n                Projections:\n                  - \"lineitem\".\"_col_0\"\n                  - lineitem._g0 AS \"_u_2\"\n                  - lineitem._g1 AS \"_u_3\"\n                Dependencies:\n                - Join: lineitem\n                  Context:\n                    Source: lineitem\n                  Projections:\n                  Condition: CAST(\"lineitem\".\"l_shipdate\" AS DATE) < CAST('1995-01-01' AS DATE) AND CAST(\"lineitem\".\"l_shipdate\" AS DATE) >= CAST('1994-01-01' AS DATE)\n                  Dependencies:\n                  - Scan: lineitem\n                    Context:\n                      Source: \"lineitem\" AS \"lineitem\"\n                    Projections:\n            - Scan: partsupp\n              Context:\n                Source: \"partsupp\" AS \"partsupp\"\n              Projections:\n      - Scan: nation\n        Context:\n          Source: \"nation_2\" AS \"nation\"\n        Projections:\n        Dependencies:\n        - Join: nation_2\n          Context:\n            Source: nation\n          Projections:\n            - \"nation\".\"n_nationkey\" AS \"n_nationkey\"\n            - \"nation\".\"n_name\" AS \"n_name\"\n          Condition: \"nation\".\"n_name\" = 'CANADA'\n          Dependencies:\n          - Scan: nation\n            Context:\n              Source: \"nation\" AS \"nation\"\n            Projections:\n      - Scan: supplier\n        Context:\n          Source: \"supplier_2\" AS \"supplier\"\n        Projections:\n        Dependencies:\n        - Join: supplier_2\n          Context:\n            Source: supplier\n          Projections:\n            - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n            - \"supplier\".\"s_name\" AS \"s_name\"\n            - \"supplier\".\"s_address\" AS \"s_address\"\n            - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n          Dependencies:\n          - Scan: supplier\n            Context:\n              Source: \"supplier\" AS \"supplier\"\n            Projections:",
  "tpch",
  "select\n        s_name,\n        count(*) as numwait\nfrom\n        supplier,\n        lineitem l1,\n        orders,\n        nation\nwhere\n        s_suppkey = l1.l_suppkey\n        and o_orderkey = l1.l_orderkey\n        and o_orderstatus = 'F'\n        and l1.l_receiptdate > l1.l_commitdate\n        and exists (\n                select\n                        *\n                from\n                        lineitem l2\n                where\n                        l2.l_orderkey = l1.l_orderkey\n                        and l2.l_suppkey <> l1.l_suppkey\n        )\n        and not exists (\n                select\n                        *\n                from\n                        lineitem l3\n                where\n                        l3.l_orderkey = l1.l_orderkey\n                        and l3.l_suppkey <> l1.l_suppkey\n                        and l3.l_receiptdate > l3.l_commitdate\n        )\n        and s_nationkey = n_nationkey\n        and n_name = 'SAUDI ARABIA'\ngroup by\n        s_name\norder by\n        numwait desc,\n        s_name\nlimit\n        100",
  "- Sort: supplier\n    Context:\n      Key:\n        - \"numwait\" DESC\n        - \"s_name\"\n    Projections:\n      - supplier._g0 AS \"s_name\"\n      - \"supplier\".\"numwait\"\n    Limit: 100\n    Dependencies:\n    - Aggregate: supplier\n      Context:\n        Aggregations:\n          - COUNT(\"_a_0\") AS \"numwait\"\n        Group:\n          - \"supplier\".\"s_name\"\n        Operands:\n          - * AS _a_0\n      Projections:\n      Dependencies:\n      - Join: supplier\n        Context:\n          Source: supplier\n          l1: INNER\n          Key: \"l1\".\"l_suppkey\"\n          On: TRUE AND TRUE\n          orders: INNER\n          Key: \"orders\".\"o_orderkey\"\n          On: TRUE AND TRUE\n          nation: INNER\n          Key: \"nation\".\"n_nationkey\"\n          On: TRUE AND TRUE\n          _u_0: LEFT\n          Key: \"_u_0\".\"l_orderkey\"\n          On: TRUE AND TRUE\n          _u_2: LEFT\n          Key: \"_u_2\".\"l_orderkey\"\n          On: TRUE AND TRUE\n        Projections:\n        Condition: (\"_u_2\".\"l_orderkey\" IS NULL OR NOT ARRAY_ANY(\"_u_2\".\"_u_3\", \"_x\" -> \"l1\".\"l_suppkey\" <> \"_x\")) AND ARRAY_ANY(\"_u_0\".\"_u_1\", \"_x\" -> \"l1\".\"l_suppkey\" <> \"_x\") AND NOT \"_u_0\".\"l_orderkey\" IS NULL\n        Dependencies:\n        - Scan: _u_0\n          Context:\n            Source: \"_u_0\" AS \"_u_0\"\n          Projections:\n          Dependencies:\n          - Aggregate: _u_0\n            Context:\n              Aggregations:\n                - ARRAY_AGG(\"l2\".\"l_suppkey\") AS \"_u_1\"\n              Group:\n                - \"l2\".\"l_orderkey\"\n            Projections:\n              - l2._g0 AS \"l_orderkey\"\n              - \"l2\".\"_u_1\"\n            Dependencies:\n            - Join: l2\n              Context:\n                Source: l2\n              Projections:\n              Dependencies:\n              - Scan: l2\n                Context:\n                  Source: \"lineitem\" AS \"l2\"\n                Projections:\n        - Scan: _u_2\n          Context:\n            Source: \"_u_2\" AS \"_u_2\"\n          Projections:\n          Dependencies:\n          - Aggregate: _u_2\n            Context:\n              Aggregations:\n                - ARRAY_AGG(\"l3\".\"l_suppkey\") AS \"_u_3\"\n              Group:\n                - \"l3\".\"l_orderkey\"\n            Projections:\n              - l3._g0 AS \"l_orderkey\"\n              - \"l3\".\"_u_3\"\n            Dependencies:\n            - Join: l3\n              Context:\n                Source: l3\n              Projections:\n              Condition: \"l3\".\"l_commitdate\" < \"l3\".\"l_receiptdate\"\n              Dependencies:\n              - Scan: l3\n                Context:\n                  Source: \"lineitem\" AS \"l3\"\n                Projections:\n        - Scan: l1\n          Context:\n            Source: \"l1\" AS \"l1\"\n          Projections:\n          Dependencies:\n          - Join: l1\n            Context:\n              Source: l1\n            Projections:\n              - \"l1\".\"l_orderkey\" AS \"l_orderkey\"\n              - \"l1\".\"l_suppkey\" AS \"l_suppkey\"\n              - \"l1\".\"l_commitdate\" AS \"l_commitdate\"\n              - \"l1\".\"l_receiptdate\" AS \"l_receiptdate\"\n            Condition: \"l1\".\"l_commitdate\" < \"l1\".\"l_receiptdate\"\n            Dependencies:\n            - Scan: l1\n              Context:\n                Source: \"lineitem\" AS \"l1\"\n              Projections:\n        - Scan: nation\n          Context:\n            Source: \"nation_2\" AS \"nation\"\n          Projections:\n          Dependencies:\n          - Join: nation_2\n            Context:\n              Source: nation\n            Projections:\n              - \"nation\".\"n_nationkey\" AS \"n_nationkey\"\n              - \"nation\".\"n_name\" AS \"n_name\"\n            Condition: \"nation\".\"n_name\" = 'SAUDI ARABIA'\n            Dependencies:\n            - Scan: nation\n              Context:\n                Source: \"nation\" AS \"nation\"\n              Projections:\n        - Scan: orders\n          Context:\n            Source: \"orders_2\" AS \"orders\"\n          Projections:\n          Dependencies:\n          - Join: orders_2\n            Context:\n              Source: orders\n            Projections:\n              - \"orders\".\"o_orderkey\" AS \"o_orderkey\"\n              - \"orders\".\"o_orderstatus\" AS \"o_orderstatus\"\n            Condition: \"orders\".\"o_orderstatus\" = 'F'\n            Dependencies:\n            - Scan: orders\n              Context:\n                Source: \"orders\" AS \"orders\"\n              Projections:\n        - Scan: supplier\n          Context:\n            Source: \"supplier_2\" AS \"supplier\"\n          Projections:\n          Dependencies:\n          - Join: supplier_2\n            Context:\n              Source: supplier\n            Projections:\n              - \"supplier\".\"s_suppkey\" AS \"s_suppkey\"\n              - \"supplier\".\"s_name\" AS \"s_name\"\n              - \"supplier\".\"s_nationkey\" AS \"s_nationkey\"\n            Dependencies:\n            - Scan: supplier\n              Context:\n                Source: \"supplier\" AS \"supplier\"\n              Projections:",
  "tpch",
  "select\n        cntrycode,\n        count(*) as numcust,\n        sum(c_acctbal) as totacctbal\nfrom\n        (\n                select\n                        substring(c_phone, 1, 2) as cntrycode,\n                        c_acctbal\n                from\n                        customer\n                where\n                        substring(c_phone, 1, 2) in\n                                ('13', '31', '23', '29', '30', '18', '17')\n                        and c_acctbal > (\n                                select\n                                        avg(c_acctbal)\n                                from\n                                        customer\n                                where\n                                        c_acctbal > 0.00\n                                        and substring(c_phone, 1, 2) in\n                                                ('13', '31', '23', '29', '30', '18', '17')\n                        )\n                        and not exists (\n                                select\n                                        *\n                                from\n                                        orders\n                                where\n                                        o_custkey = c_custkey\n                        )\n        ) as custsale\ngroup by\n        cntrycode\norder by\n        cntrycode",
  "- Sort: customer\n    Context:\n      Key:\n        - \"cntrycode\"\n    Projections:\n      - customer._g0 AS \"cntrycode\"\n      - \"customer\".\"numcust\"\n      - \"customer\".\"totacctbal\"\n    Dependencies:\n    - Aggregate: customer\n      Context:\n        Aggregations:\n          - COUNT(\"_a_0\") AS \"numcust\"\n          - SUM(\"customer\".\"c_acctbal\") AS \"totacctbal\"\n        Group:\n          - SUBSTRING(\"customer\".\"c_phone\", 1, 2)\n        Operands:\n          - * AS _a_0\n      Projections:\n      Dependencies:\n      - Join: customer\n        Context:\n          Source: customer\n          _u_0: INNER\n          On: \"_u_0\".\"_col_0\" < \"customer\".\"c_acctbal\" AND TRUE\n          _u_1: LEFT\n          Key: \"_u_1\".\"_u_2\"\n          On: TRUE AND TRUE\n        Projections:\n        Condition: \"_u_1\".\"_u_2\" IS NULL AND SUBSTRING(\"customer\".\"c_phone\", 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')\n        Dependencies:\n        - Scan: _u_0\n          Context:\n            Source: \"_u_0\" AS \"_u_0\"\n          Projections:\n          Dependencies:\n          - Aggregate: _u_0\n            Context:\n              Aggregations:\n                - AVG(\"customer\".\"c_acctbal\") AS \"_col_0\"\n            Projections:\n              - \"customer\".\"_col_0\"\n            Dependencies:\n            - Join: customer\n              Context:\n                Source: customer\n              Projections:\n              Condition: \"customer\".\"c_acctbal\" > 0.00 AND SUBSTRING(\"customer\".\"c_phone\", 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')\n              Dependencies:\n              - Scan: customer\n                Context:\n                  Source: \"customer\" AS \"customer\"\n                Projections:\n        - Scan: _u_1\n          Context:\n            Source: \"_u_1\" AS \"_u_1\"\n          Projections:\n          Dependencies:\n          - Aggregate: _u_1\n            Context:\n              Aggregations:\n              Group:\n                - \"orders\".\"o_custkey\"\n            Projections:\n              - orders._g0 AS \"_u_2\"\n            Dependencies:\n            - Join: orders\n              Context:\n                Source: orders\n              Projections:\n              Dependencies:\n              - Scan: orders\n                Context:\n                  Source: \"orders\" AS \"orders\"\n                Projections:\n        - Scan: customer\n          Context:\n            Source: \"customer\" AS \"customer\"\n          Projections:",
  "extra",
  "SELECT a, SUM(b) AS s FROM x GROUP BY a HAVING SUM(b) > 1 ORDER BY s DESC LIMIT 10",
  "- Sort: x\n    Context:\n      Key:\n        - \"s\" DESC\n    Projections:\n      - x._g0 AS \"a\"\n      - \"x\".\"s\"\n    Limit: 10\n    Dependencies:\n    - Aggregate: x\n      Context:\n        Aggregations:\n          - SUM(\"x\".\"b\") AS \"s\"\n          - SUM(\"x\".\"b\") > 1 AS \"_h\"\n        Group:\n          - \"x\".\"a\"\n        Having:\n          - \"x\".\"_h\"\n      Projections:\n      Condition: \"x\".\"_h\"\n      Dependencies:\n      - Join: x\n        Context:\n          Source: x\n        Projections:\n        Dependencies:\n        - Scan: x\n          Context:\n            Source: \"x\" AS \"x\"\n          Projections:",
  "extra",

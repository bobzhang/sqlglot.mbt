///|
/// The class in the MRO of `self` that defines `name` (None for the base `Expression`).
pub fn Kind::owner_name(self : Kind) -> Kind? {
  let o = kind_owner_name[self.id()]
  if o < 0 { None } else { Some(all_kinds[o]) }
}


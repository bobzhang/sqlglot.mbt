  mut timestamps : TokenSet
  mut transaction_characteristics : Map[String, Array[Array[String]]]
  mut transaction_kind : @set.Set[String]
  mut trigger_deferrable : Map[String, Array[Array[String]]]
  mut trigger_events : TokenSet
  mut trigger_timing : Map[String, Array[Array[String]]]
  mut trim_pattern_first : Bool
  mut trim_types : @set.Set[String]
  mut typed_lambda_args : Bool
  mut type_tokens : TokenSet
  mut unnest_offset_alias_tokens : TokenSet
  mut unpivot_value_columns_first : Bool
  mut update_alias_tokens : TokenSet
  mut usables : Map[String, Array[Array[String]]]
  mut values_followed_by_paren : Bool
  mut version_phrases : Array[(Array[String], String)]
  mut view_attributes : @set.Set[String]
  mut window_alias_tokens : TokenSet
  mut window_before_paren_tokens : TokenSet
  mut window_exclude_options : Map[String, Array[Array[String]]]
  mut window_sides : @set.Set[String]
  mut wrapped_transform_column_constraint : Bool
  mut zone_aware_timestamp_constructor : Bool
}


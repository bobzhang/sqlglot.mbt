pub struct Dialect {
  name : String
  cfg : DialectConfig
  tokenizer : TokenizerSettings
  jsonpath_tokenizer : TokenizerSettings
  mut jsonpath_var_tokens : Array[TokenType]
  parser_cfg : ParserConfig
  parser_fns : ParserFns
  gen_cfg : GeneratorConfig
  gen_fns : GeneratorFns
  hooks : DialectHooks
  mut normalization_strategy : NormalizationStrategy
  mut version : (Int, Int, Int)
  settings : Map[String, String]
  mut supported_settings : Array[String]
  mut time_trie : Trie
  mut format_trie : Trie
  mut inverse_time_trie : Trie
  mut inverse_format_trie : Trie
  parent : Dialect?
}
pub fn Dialect::base() -> Self
pub fn Dialect::can_quote(Self, Expr, identify? : String) -> Bool
pub fn Dialect::can_quote_base(Self, Expr, identify? : String) -> Bool
pub fn Dialect::case_sensitive(Self, String) -> Bool
pub fn Dialect::finalize(Self) -> Self
pub fn Dialect::format_time(Self, Expr?) -> Expr?
pub fn Dialect::format_time_str(Self, String) -> Expr
pub fn Dialect::generate_sql(Self, Expr) -> String raise SqlglotError
pub fn Dialect::generate_values_aliases(Self, Expr) -> Array[Expr]
pub fn Dialect::get_or_raise(String) -> Self raise SqlglotError
pub fn Dialect::instance(Self) -> Self
pub fn Dialect::normalize_identifier(Self, Expr) -> Expr
pub fn Dialect::normalize_identifier_base(Self, Expr) -> Expr
pub fn Dialect::parse(Self, String, error_level? : ErrorLevel, error_message_context? : Int, max_errors? : Int, max_nodes? : Int) -> Array[Expr?] raise SqlglotError
pub fn Dialect::parse_into(Self, Array[Kind], String, error_level? : ErrorLevel, error_message_context? : Int, max_errors? : Int, max_nodes? : Int, into_is_list? : Bool) -> Array[Expr?] raise SqlglotError
pub fn Dialect::parser(Self, error_level? : ErrorLevel, error_message_context? : Int, max_errors? : Int, max_nodes? : Int) -> Parser
pub fn Dialect::quote_identifier(Self, Expr, identify? : Bool) -> Expr
pub fn Dialect::subclass(Self, String, (Self) -> Unit) -> Self
pub fn Dialect::to_json_path(Self, Expr?) -> Expr? raise SqlglotError
pub fn Dialect::to_json_path_base(Self, Expr?) -> Expr? raise SqlglotError
pub fn Dialect::tokenize(Self, String) -> Array[Token] raise SqlglotError
pub fn Dialect::tokenize_base(Self, String) -> Array[Token] raise SqlglotError
pub impl Eq for Dialect
pub impl Show for Dialect

pub(all) struct DialectConfig {
  mut alias_post_tablesample : Bool
  mut alias_post_version : Bool
  mut alter_table_add_required_for_each_column : Bool
  mut alter_table_supports_cascade : Bool
  mut annotate_all_scopes : Bool
  mut array_agg_includes_nulls : Bool?
  mut array_funcs_propagates_nulls : Bool
  mut ascii_only_normalization : Bool
  mut bit_end : String?
  mut bit_start : String?
  mut byte_end : String?
  mut byte_start : String?
  mut byte_strings_support_escaped_sequences : Bool
  mut byte_string_is_bytes_type : Bool
  mut coalesce_comparison_non_standard : Bool
  mut concat_coalesce : Bool
  mut concat_ws_coalesce : Bool
  mut copy_params_are_csv : Bool
  mut creatable_kind_mapping : Map[String, String]
  mut dateint_format : String
  mut date_format : String
  mut date_part_mapping : Map[String, String]
  mut default_functions_column_names : Map[Kind, String]
  mut default_null_type : DType
  mut disables_alias_ref_expansion : Bool
  mut dpipe_is_string_concat : Bool
  mut escaped_sequences : Map[String, String]
  mut excludes_pseudocolumns_from_star : Bool
  mut expand_only_group_alias_ref : Bool
  mut force_early_alias_ref_expansion : Bool
  mut format_mapping : Map[String, String]
  mut has_distinct_array_constructors : Bool
  mut hex_end : String?
  mut hex_lowercase : Bool
  mut hex_start : String?
  mut hex_string_is_integer_type : Bool
  mut identifiers_can_start_with_digit : Bool
  mut identifier_end : String
  mut identifier_start : String
  mut index_offset : Int
  mut initcap_default_delimiter_chars : String
  mut initcap_supports_custom_delimiters : Bool
  mut inverse_creatable_kind_mapping : Map[String, String]
  mut inverse_format_mapping : Map[String, String]
  mut inverse_time_mapping : Map[String, String]
  mut inverse_vector_type_aliases : Map[String, String]
  mut json_extract_scalar_scalar_only : Bool
  mut json_path_single_dot_is_wildcard : Bool
  mut least_greatest_ignores_nulls : Bool
  mut log_base_first : Bool?
  mut normalization_strategy : NormalizationStrategy
  mut normalize_functions : StrOrBool
  mut normalize_not_null : Bool
  mut null_ordering : String
  mut numbers_can_be_underscore_separated : Bool
  mut on_condition_empty_before_error : Bool
  mut prefer_cte_alias_column : Bool
  mut preserve_original_names : Bool
  mut prioritize_non_literal_types : Bool
  mut projection_aliases_shadow_source_names : Bool
  mut promote_to_inferred_datetime_type : Bool
  mut pseudocolumns : @set.Set[String]
  mut query_results_are_structs : Bool
  mut quote_end : String
  mut quote_start : String
  mut regexp_extract_default_group : Int
  mut regexp_extract_position_overflow_returns_null : Bool
  mut requires_parenthesized_struct_access : Bool
  mut safe_division : Bool
  mut safe_to_eliminate_double_negation : Bool
  mut set_op_distinct_by_default : Map[Kind, Bool?]
  mut star_ilike_backslash_escape : Bool
  mut strict_json_path_syntax : Bool
  mut strict_string_concat : Bool
  mut strings_support_escaped_sequences : Bool
  mut supports_alias_refs_in_join_conditions : Bool
  mut supports_column_join_marks : Bool
  mut supports_fixed_size_arrays : Bool
  mut supports_limit_all : Bool
  mut supports_null_type : Bool
  mut supports_order_by_all : Bool
  mut supports_positional_column_refs : Bool
  mut supports_struct_star_expansion : Bool
  mut supports_user_defined_types : Bool
  mut supports_values_default : Bool
  mut tablesample_size_is_percent : Bool
  mut tables_referenceable_as_columns : Bool
  mut time_format : String
  mut time_mapping : Map[String, String]
  mut try_cast_requires_string : Bool?
  mut typed_division : Bool
  mut unescaped_sequences : Map[String, String]
  mut unicode_end : String?
  mut unicode_start : String?
  mut unnest_column_only : Bool
  mut uuid_is_string_type : Bool
  mut valid_interval_units : @set.Set[String]
  mut week_offset : Int
}
pub fn DialectConfig::copy(Self) -> Self

pub(all) struct DialectHooks {
  mut normalize_identifier : ((Dialect, Expr) -> Expr)?
  mut generate_values_aliases : ((Dialect, Expr) -> Array[Expr])?
  mut tokenize : ((Dialect, String) -> Array[Token] raise SqlglotError)?
  mut can_quote : ((Dialect, Expr, String) -> Bool)?
  mut to_json_path : ((Dialect, Expr?) -> Expr? raise SqlglotError)?
  mut extra : Map[String, (Dialect, Expr) -> Expr?]
}
pub fn DialectHooks::copy(Self) -> Self
pub fn DialectHooks::new() -> Self

pub(all) enum ErrorLevel {
  Ignore
  Warn
  Raise
  Immediate
} derive(Eq, Show)


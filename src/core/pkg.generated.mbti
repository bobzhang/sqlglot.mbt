pub fn WordTrie::lookup(Self, ArrayView[String]) -> (TrieResult, Self)
pub fn WordTrie::new() -> Self

// Type aliases
pub type ColumnOpFn = (Parser, Expr?, Expr?) -> Expr? raise SqlglotError

pub type FuncBuilder = (Array[Expr], Parser) -> Expr raise SqlglotError

pub type GenExprFn = (Generator, Expr) -> Expr raise SqlglotError

pub type GenFn = (Generator, Expr) -> String raise SqlglotError

pub type ParseFn = (Parser) -> Expr? raise SqlglotError

pub type ParseFn1 = (Parser, Expr?) -> Expr? raise SqlglotError

pub type PropKwargs = Map[String, Bool]

pub type PropLocs = Map[PropertiesLocation, Array[Expr]]

pub type PropertyFn = (Parser, Map[String, Bool]) -> Value? raise SqlglotError

pub type TokenParseFn = (Parser, Token) -> Expr? raise SqlglotError

pub type Transform = (Expr) -> Expr raise SqlglotError

// Traits
pub(open) trait IntoPy {
  fn into_py(Self) -> PyObj
}
pub impl IntoPy for Bool
pub impl IntoPy for Int
pub impl IntoPy for Int64
pub impl IntoPy for Double
pub impl IntoPy for String
pub impl[T : IntoPy] IntoPy for T?
pub impl IntoPy for Bytes
pub impl[T : IntoPy] IntoPy for Array[T]
pub impl[V : IntoPy] IntoPy for Map[String, V]

pub trait IntoValue {
  fn into_value(Self) -> Value?
}
pub impl IntoValue for Bool
pub impl IntoValue for Int
pub impl IntoValue for Int64
pub impl IntoValue for String
pub impl[T : IntoValue] IntoValue for T?
pub impl[T : IntoValue] IntoValue for Array[T]

pub trait SqlArg {
  fn arg_sql(Self, Generator) -> String? raise SqlglotError
}
pub impl SqlArg for String
pub impl[T : SqlArg] SqlArg for T?

// Base `<key>_sql` dispatch (generated from the Python Generator's method names).

///|
/// The base Generator's `<key>_sql` method for `kind`, if any (Python `_build_dispatch`
/// minus `TRANSFORMS`).
pub fn Generator::base_dispatch(
  self : Generator,
  kind : Kind,
  e : Expr,
) -> String? raise SqlglotError {
  let s = match kind {
    Kind::Add => self.add_sql(e)
    Kind::AddConstraint => self.addconstraint_sql(e)
    Kind::AddPartition => self.addpartition_sql(e)
    Kind::AIForecast => self.aiforecast_sql(e)
    Kind::Alias => self.alias_sql(e)
    Kind::Aliases => self.aliases_sql(e)
    Kind::All => self.all_sql(e)
    Kind::Alter => self.alter_sql(e)
    Kind::AlterColumn => self.altercolumn_sql(e)
    Kind::AlterDistStyle => self.alterdiststyle_sql(e)
    Kind::AlterIndex => self.alterindex_sql(e)
    Kind::AlterModifySqlSecurity => self.altermodifysqlsecurity_sql(e)
    Kind::AlterRename => self.alterrename_sql_v(e)
    Kind::AlterSession => self.altersession_sql(e)
    Kind::AlterSet => self.alterset_sql(e)
    Kind::AlterSortKey => self.altersortkey_sql(e)
    Kind::Analyze => self.analyze_sql(e)
    Kind::AnalyzeDelete => self.analyzedelete_sql(e)
    Kind::AnalyzeHistogram => self.analyzehistogram_sql(e)

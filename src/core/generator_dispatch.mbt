    Kind::And => self.and_sql(e)
    Kind::Anonymous => self.anonymous_sql(e)
    Kind::AnonymousAggFunc => self.anonymousaggfunc_sql(e)
    Kind::Any => self.any_sql(e)
    Kind::AnyValue => self.anyvalue_sql(e)
    Kind::Apply => self.apply_sql(e)
    Kind::ArrayAgg => self.arrayagg_sql(e)
    Kind::ArrayAny => self.arrayany_sql(e)
    Kind::ArrayInsert => self.arrayinsert_sql_v(e)
    Kind::ArraySize => self.arraysize_sql(e)
    Kind::AtIndex => self.atindex_sql(e)
    Kind::Attach => self.attach_sql(e)
    Kind::AttachOption => self.attachoption_sql(e)
    Kind::AtTimeZone => self.attimezone_sql(e)
    Kind::AutoIncrementColumnConstraint =>
      self.autoincrementcolumnconstraint_sql(e)

  "optimize", "", "{}", "WITH regional_sales AS (\n    SELECT region, SUM(amount) AS total_sales\n    FROM orders\n    GROUP BY region\n    ), top_regions AS (\n    SELECT region\n    FROM regional_sales\n    WHERE total_sales > (SELECT SUM(total_sales)/10 FROM regional_sales)\n)\nSELECT region,\nproduct,\nSUM(quantity) AS product_units,\nSUM(amount) AS product_sales\nFROM orders\nWHERE region IN (SELECT region FROM top_regions)\nGROUP BY region, product", "WITH \"regional_sales\" AS (SELECT \"orders\".\"region\" AS \"region\", SUM(\"orders\".\"amount\") AS \"total_sales\" FROM \"orders\" AS \"orders\" GROUP BY \"orders\".\"region\"), \"_u_0\" AS (SELECT SUM(\"regional_sales\".\"total_sales\") / 10 AS \"_col_0\" FROM \"regional_sales\" AS \"regional_sales\"), \"_u_1\" AS (SELECT \"regional_sales\".\"region\" AS \"region\" FROM \"regional_sales\" AS \"regional_sales\" JOIN \"_u_0\" AS \"_u_0\" ON \"_u_0\".\"_col_0\" < \"regional_sales\".\"total_sales\" GROUP BY \"regional_sales\".\"region\") SELECT \"orders\".\"region\" AS \"region\", \"orders\".\"product\" AS \"product\", SUM(\"orders\".\"quantity\") AS \"product_units\", SUM(\"orders\".\"amount\") AS \"product_sales\" FROM \"orders\" AS \"orders\" LEFT JOIN \"_u_1\" AS \"_u_1\" ON \"_u_1\".\"region\" = \"orders\".\"region\" WHERE NOT \"_u_1\".\"region\" IS NULL GROUP BY \"orders\".\"region\", \"orders\".\"product\"",
  "qualify", "", "{}", "WITH regional_sales AS (\n    SELECT region, SUM(amount) AS total_sales\n    FROM orders\n    GROUP BY region\n    ), top_regions AS (\n    SELECT region\n    FROM regional_sales\n    WHERE total_sales > (SELECT SUM(total_sales)/10 FROM regional_sales)\n)\nSELECT region,\nproduct,\nSUM(quantity) AS product_units,\nSUM(amount) AS product_sales\nFROM orders\nWHERE region IN (SELECT region FROM top_regions)\nGROUP BY region, product", "WITH \"regional_sales\" AS (SELECT \"orders\".\"region\" AS \"region\", SUM(\"orders\".\"amount\") AS \"total_sales\" FROM \"orders\" AS \"orders\" GROUP BY \"orders\".\"region\"), \"top_regions\" AS (SELECT \"regional_sales\".\"region\" AS \"region\" FROM \"regional_sales\" AS \"regional_sales\" WHERE \"regional_sales\".\"total_sales\" > (SELECT SUM(\"regional_sales\".\"total_sales\") / 10 AS \"_col_0\" FROM \"regional_sales\" AS \"regional_sales\")) SELECT \"orders\".\"region\" AS \"region\", \"orders\".\"product\" AS \"product\", SUM(\"orders\".\"quantity\") AS \"product_units\", SUM(\"orders\".\"amount\") AS \"product_sales\" FROM \"orders\" AS \"orders\" WHERE \"orders\".\"region\" IN (SELECT \"top_regions\".\"region\" AS \"region\" FROM \"top_regions\" AS \"top_regions\") GROUP BY \"orders\".\"region\", \"orders\".\"product\"",
  "annotate", "", "{}", "WITH regional_sales AS (\n    SELECT region, SUM(amount) AS total_sales\n    FROM orders\n    GROUP BY region\n    ), top_regions AS (\n    SELECT region\n    FROM regional_sales\n    WHERE total_sales > (SELECT SUM(total_sales)/10 FROM regional_sales)\n)\nSELECT region,\nproduct,\nSUM(quantity) AS product_units,\nSUM(amount) AS product_sales\nFROM orders\nWHERE region IN (SELECT region FROM top_regions)\nGROUP BY region, product", "UNKNOWN",

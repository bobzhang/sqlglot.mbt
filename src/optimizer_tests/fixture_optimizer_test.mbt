  "pivoted source with implicit selections", "", "{}", "SELECT * FROM (SELECT * FROM u) PIVOT (SUM(f) FOR h IN ('x', 'y'))", "SELECT\n  \"_1\".\"g\" AS \"g\",\n  \"_1\".\"x\" AS \"x\",\n  \"_1\".\"y\" AS \"y\"\nFROM (\n  SELECT\n    \"u\".\"f\" AS \"f\",\n    \"u\".\"g\" AS \"g\",\n    \"u\".\"h\" AS \"h\"\n  FROM \"u\" AS \"u\"\n) AS \"_0\"\nPIVOT(SUM(\"_0\".\"f\") FOR \"_0\".\"h\" IN ('x', 'y')) AS \"_1\"",
  "selecting explicit qualified columns from pivoted source with explicit selections", "", "{}", "SELECT piv.x, piv.y FROM (SELECT f, h FROM u) PIVOT (SUM(f) FOR h IN ('x', 'y')) AS piv", "SELECT\n  \"piv\".\"x\" AS \"x\",\n  \"piv\".\"y\" AS \"y\"\nFROM (\n  SELECT\n    \"u\".\"f\" AS \"f\",\n    \"u\".\"h\" AS \"h\"\n  FROM \"u\" AS \"u\"\n) AS \"_0\"\nPIVOT(SUM(\"_0\".\"f\") FOR \"_0\".\"h\" IN ('x', 'y')) AS \"piv\"",

  "snowflake", "\n            select\n              dag_report.acct_id,\n              dag_report.report_date,\n              dag_report.report_uuid,\n              dag_report.airflow_name,\n              dag_report.dag_id,\n              f.value::varchar as operator\n            from cs.telescope.dag_report,\n            table(flatten(input=>split(operators, ','))) f\n            ", "SELECT \"DAG_REPORT\".\"ACCT_ID\" AS \"ACCT_ID\", \"DAG_REPORT\".\"REPORT_DATE\" AS \"REPORT_DATE\", \"DAG_REPORT\".\"REPORT_UUID\" AS \"REPORT_UUID\", \"DAG_REPORT\".\"AIRFLOW_NAME\" AS \"AIRFLOW_NAME\", \"DAG_REPORT\".\"DAG_ID\" AS \"DAG_ID\", CAST(\"F\".\"VALUE\" AS VARCHAR) AS \"OPERATOR\" FROM \"CS\".\"TELESCOPE\".\"DAG_REPORT\" AS \"DAG_REPORT\" CROSS JOIN TABLE(FLATTEN(input => SPLIT(\"DAG_REPORT\".\"OPERATORS\", ','))) AS \"F\"",
  "snowflake", "\n            SELECT\n              uc.user_id,\n              uc.start_ts AS ts,\n              CASE\n                WHEN uc.start_ts::DATE >= '2023-01-01' AND uc.country_code IN ('US') AND uc.user_id NOT IN (\n                  SELECT DISTINCT\n                    _id\n                  FROM\n                    users,\n                    LATERAL FLATTEN(INPUT => PARSE_JSON(flags)) datasource\n                  WHERE datasource.value:name = 'something'\n                )\n                  THEN 'Sample1'\n                  ELSE 'Sample2'\n              END AS entity\n            FROM user_countries AS uc\n            LEFT JOIN (\n              SELECT user_id, MAX(IFF(service_entity IS NULL,1,0)) AS le_null\n              FROM accepted_user_agreements\n              GROUP BY 1\n            ) AS aua\n              ON uc.user_id = aua.user_id\n            ", "SELECT \"UC\".\"USER_ID\" AS \"USER_ID\", \"UC\".\"START_TS\" AS \"TS\", CASE WHEN \"UC\".\"COUNTRY_CODE\" IN ('US') AND \"UC\".\"USER_ID\" <> ALL (SELECT DISTINCT \"USERS\".\"_ID\" AS \"_ID\" FROM \"USERS\" AS \"USERS\" JOIN LATERAL IFF(_u.pos = _u_2.pos_2, _u_2.\"ENTITY\", NULL) AS \"DATASOURCE\"(\"SEQ\", \"KEY\", \"PATH\", \"INDEX\", \"VALUE\", \"THIS\") ON GET_PATH(\"DATASOURCE\".\"VALUE\", 'name') = 'something') AND CAST(\"UC\".\"START_TS\" AS DATE) >= CAST('2023-01-01' AS DATE) THEN 'Sample1' ELSE 'Sample2' END AS \"ENTITY\" FROM \"USER_COUNTRIES\" AS \"UC\" CROSS JOIN TABLE(FLATTEN(INPUT => ARRAY_GENERATE_RANGE(0, (GREATEST(ARRAY_SIZE(INPUT => PARSE_JSON(\"USERS\".\"FLAGS\"))) - 1) + 1))) AS _u(seq, key, path, index, pos, this) CROSS JOIN TABLE(FLATTEN(INPUT => PARSE_JSON(\"USERS\".\"FLAGS\"))) AS _u_2(seq, key, path, pos_2, \"ENTITY\", this) WHERE _u.pos = _u_2.pos_2 OR (_u.pos > (ARRAY_SIZE(INPUT => PARSE_JSON(\"USERS\".\"FLAGS\")) - 1) AND _u_2.pos_2 = (ARRAY_SIZE(INPUT => PARSE_JSON(\"USERS\".\"FLAGS\")) - 1))",
  "snowflake", "SELECT value FROM TABLE(FLATTEN(input => SELECT PARSE_JSON('[1, 2]')))", "SELECT \"_0\".\"VALUE\" AS \"VALUE\" FROM TABLE(FLATTEN(input => SELECT PARSE_JSON('[1, 2]') AS \"_COL_0\")) AS \"_0\"",

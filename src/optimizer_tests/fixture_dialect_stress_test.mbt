  "snowflake", "SELECT * FROM TABLE(FLATTEN(input => parse_json('{\"a\":1, \"b\":[77,88], \"c\": {\"d\":\"X\"}}'), recursive => true)) f", "ERROR: OptimizeError: projection_reachability requires star-free selections",
  "snowflake", "SELECT * FROM TABLE(FLATTEN(input => parse_json('{\"a\":1, \"b\":[77,88], \"c\": {\"d\":\"X\"}}'), recursive => true, mode => 'object')) f", "ERROR: OptimizeError: projection_reachability requires star-free selections",
  "snowflake", "\n            SELECT id as \"ID\",\n              f.value AS \"Contact\",\n              f1.value:type AS \"Type\",\n              f1.value:content AS \"Details\"\n            FROM persons p,\n              lateral flatten(input => p.c, path => 'contact') f,\n              lateral flatten(input => f.value:business) f1\n            ", "SELECT \"P\".\"ID\" AS \"ID\", \"F\".\"VALUE\" AS \"Contact\", GET_PATH(\"F1\".\"VALUE\", 'type') AS \"Type\", GET_PATH(\"F1\".\"VALUE\", 'content') AS \"Details\" FROM \"PERSONS\" AS \"P\" CROSS JOIN LATERAL FLATTEN(input => \"P\".\"C\", path => 'contact') AS \"F\"(\"SEQ\", \"KEY\", \"PATH\", \"INDEX\", \"VALUE\", \"THIS\") CROSS JOIN LATERAL FLATTEN(input => GET_PATH(\"F\".\"VALUE\", 'business')) AS \"F1\"(\"SEQ\", \"KEY\", \"PATH\", \"INDEX\", \"VALUE\", \"THIS\")",
  "snowflake", "\n            SELECT id as \"ID\",\n              value AS \"Contact\"\n            FROM persons p,\n              lateral flatten(input => p.c, path => 'contact')\n            ", "SELECT \"P\".\"ID\" AS \"ID\", \"_FLATTENED\".\"VALUE\" AS \"Contact\" FROM \"PERSONS\" AS \"P\" CROSS JOIN LATERAL FLATTEN(input => \"P\".\"C\", path => 'contact') AS \"_FLATTENED\"(\"SEQ\", \"KEY\", \"PATH\", \"INDEX\", \"VALUE\", \"THIS\")",

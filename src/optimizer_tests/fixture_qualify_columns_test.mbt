  "156, WITH cte(x) AS (SELECT 1) SELECT * FROM cte AS cte(a)", "", "{}", "WITH cte(x) AS (SELECT 1) SELECT * FROM cte AS cte(a)", "WITH cte AS (SELECT 1 AS x) SELECT cte.a AS a FROM cte AS cte(a)",

  "167, SELECT * EXCEPT (b, y.c) FROM x AS x JOIN y AS y ON x.b = y.b", "", "{}", "SELECT * EXCEPT (b, y.c) FROM x AS x JOIN y AS y ON x.b = y.b", "SELECT x.a AS a FROM x AS x JOIN y AS y ON x.b = y.b",

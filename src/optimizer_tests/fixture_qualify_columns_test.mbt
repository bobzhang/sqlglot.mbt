  "153, WITH z AS (SELECT * FROM x) SELECT * FROM z UNION SELECT * FROM z ORDER BY a, b", "", "{}", "WITH z AS (SELECT * FROM x) SELECT * FROM z UNION SELECT * FROM z ORDER BY a, b", "WITH z AS (SELECT x.a AS a, x.b AS b FROM x AS x) SELECT z.a AS a, z.b AS b FROM z AS z UNION SELECT z.a AS a, z.b AS b FROM z AS z ORDER BY a, b",
  "154, WITH z AS (SELECT * FROM x), q AS (SELECT b FROM z) SELECT b FROM q", "", "{}", "WITH z AS (SELECT * FROM x), q AS (SELECT b FROM z) SELECT b FROM q", "WITH z AS (SELECT x.a AS a, x.b AS b FROM x AS x), q AS (SELECT z.b AS b FROM z AS z) SELECT q.b AS b FROM q AS q",

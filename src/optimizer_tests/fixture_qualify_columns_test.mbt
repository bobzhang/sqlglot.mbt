  "wrap expanded alias to ensure operator precedence isnt broken", "", "{}", "SELECT x.a + x.b AS f, f * x.b FROM x", "SELECT x.a + x.b AS f, (x.a + x.b) * x.b AS _col_1 FROM x AS x",
  "no need to wrap expanded alias", "", "{}", "SELECT x.a + x.b AS f, f, f + 5 FROM x", "SELECT x.a + x.b AS f, x.a + x.b AS _col_1, x.a + x.b + 5 AS _col_2 FROM x AS x",

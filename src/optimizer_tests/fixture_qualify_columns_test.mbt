  "expand alias reference", "", "{}", "SELECT\n  x.a + 1 AS i,\n  i + 1 AS j,\n  j + 1 AS k\nFROM x", "SELECT x.a + 1 AS i, x.a + 1 + 1 AS j, x.a + 1 + 1 + 1 AS k FROM x AS x",

  "SEMI JOIN table is excluded from the scope", "", "{}", "SELECT * FROM x SEMI JOIN y USING (b)", "SELECT x.a AS a, x.b AS b FROM x AS x SEMI JOIN y AS y ON x.b = y.b",
  "ANTI JOIN table is excluded from the scope", "", "{}", "SELECT * FROM x ANTI JOIN y USING (b)", "SELECT x.a AS a, x.b AS b FROM x AS x ANTI JOIN y AS y ON x.b = y.b",
  "SEMI + normal joins reinclude the table on scope", "", "{}", "SELECT * FROM x SEMI JOIN y USING (b) JOIN y USING (b)", "SELECT x.a AS a, COALESCE(x.b, y_2.b) AS b, y_2.c AS c FROM x AS x SEMI JOIN y AS y ON x.b = y.b JOIN y AS y_2 ON x.b = y_2.b",
  "ANTI + normal joins reinclude the table on scope", "", "{}", "SELECT * FROM x ANTI JOIN y USING (b) JOIN y USING (b)", "SELECT x.a AS a, COALESCE(x.b, y_2.b) AS b, y_2.c AS c FROM x AS x ANTI JOIN y AS y ON x.b = y.b JOIN y AS y_2 ON x.b = y_2.b",
  "unqualified column in ANTI JOIN's ON clause resolves to that join's own table, not a later join sharing the same column name", "", "{}", "SELECT w.d FROM w ANTI JOIN y ON b > 0 JOIN z ON TRUE", "SELECT w.d AS d FROM w AS w ANTI JOIN y AS y ON y.b > 0 JOIN z AS z ON TRUE",
  "unqualified column in SEMI JOIN's ON clause resolves to that join's own table, not a later join sharing the same column name", "", "{}", "SELECT w.d FROM w SEMI JOIN y ON b > 0 JOIN z ON TRUE", "SELECT w.d AS d FROM w AS w SEMI JOIN y AS y ON y.b > 0 JOIN z AS z ON TRUE",
  "self-join -- ANTI JOIN's own alias wins over a later normal join of the same table", "", "{}", "SELECT w.d FROM w ANTI JOIN x AS x1 ON a > 0 JOIN x AS x2 ON TRUE", "SELECT w.d AS d FROM w AS w ANTI JOIN x AS x1 ON x1.a > 0 JOIN x AS x2 ON TRUE",
  "derived table (subquery) as the ANTI JOIN's own source -- unqualified column resolves into the derived table, not a later derived source sharing the same column name", "", "{}", "SELECT w.d FROM w ANTI JOIN (SELECT a FROM x) AS m ON a > 0 JOIN (SELECT a FROM x) AS n ON TRUE", "SELECT w.d AS d FROM w AS w ANTI JOIN (SELECT x.a AS a FROM x AS x) AS m ON m.a > 0 JOIN (SELECT x.a AS a FROM x AS x) AS n ON TRUE",
  "unqualified column in a normal JOIN's ON clause that comes after a SEMI JOIN still sees that later join's own table, not the earlier SEMI JOIN's now out-of-scope table", "", "{}", "SELECT x.a FROM x SEMI JOIN y ON x.b = y.b JOIN z ON c > 0", "SELECT x.a AS a FROM x AS x SEMI JOIN y AS y ON x.b = y.b JOIN z AS z ON z.c > 0",
  "chained UNPIVOT, source is a CTE", "duckdb", "{}", "WITH t AS (SELECT 1 AS id, 100 AS jan, 200 AS feb, 7 AS north, 8 AS south) SELECT * FROM t UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south))", "WITH t AS (SELECT 1 AS id, 100 AS jan, 200 AS feb, 7 AS north, 8 AS south) SELECT t.id AS id, t.month AS month, t.revenue AS revenue, t.region AS region, t.headcount AS headcount FROM t AS t UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south)) AS t",
  "chained UNPIVOT, source columns come from the schema", "duckdb", "{}", "SELECT * FROM unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south))", "SELECT unpivotable.id AS id, unpivotable.month AS month, unpivotable.revenue AS revenue, unpivotable.region AS region, unpivotable.headcount AS headcount FROM unpivotable AS unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south)) AS unpivotable",
  "chained UNPIVOT, explicit columns under the chain's alias", "duckdb", "{}", "WITH t AS (SELECT 1 AS id, 100 AS jan, 200 AS feb, 7 AS north, 8 AS south) SELECT u.month, u.headcount FROM t UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south)) AS u", "WITH t AS (SELECT 1 AS id, 100 AS jan, 200 AS feb, 7 AS north, 8 AS south) SELECT u.month AS month, u.headcount AS headcount FROM t AS t UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south)) AS u",
  "chained PIVOT, the second groups by what the first produced", "duckdb", "{}", "SELECT * FROM pivotable PIVOT(SUM(val) FOR cat IN ('a' AS a, 'b' AS b)) PIVOT(SUM(amt) FOR kind IN ('x' AS x, 'y' AS y))", "SELECT _0.id AS id, _0.a AS a, _0.b AS b, _0.x AS x, _0.y AS y FROM pivotable AS pivotable PIVOT(SUM(val) FOR cat IN ('a' AS a, 'b' AS b)) PIVOT(SUM(amt) FOR kind IN ('x' AS x, 'y' AS y)) AS _0",
  "PIVOT then UNPIVOT of the columns it produced", "duckdb", "{}", "SELECT * FROM pivotable PIVOT(SUM(val) FOR cat IN ('a' AS a, 'b' AS b)) UNPIVOT(v FOR c IN (a, b))", "SELECT pivotable.id AS id, pivotable.kind AS kind, pivotable.amt AS amt, pivotable.c AS c, pivotable.v AS v FROM pivotable AS pivotable PIVOT(SUM(val) FOR cat IN ('a' AS a, 'b' AS b)) UNPIVOT(v FOR c IN (a, b)) AS pivotable",
  "a source joined next to a pivoted one is not expanded through its operators", "duckdb", "{}", "SELECT * FROM x JOIN unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) AS u ON x.a = u.id", "SELECT x.a AS a, x.b AS b, u.id AS id, u.north AS north, u.south AS south, u.month AS month, u.revenue AS revenue FROM x AS x JOIN unpivotable AS unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) AS u ON x.a = u.id",
  "chained UNPIVOT keeps quoted identifiers case-sensitive, unlike the names it produces", "snowflake", "{}", "WITH t AS (SELECT 1 AS \"Id\", 2 AS \"Jan\", 3 AS \"Feb\", 4 AS \"Nor\", 5 AS \"Sou\") SELECT * FROM t UNPIVOT(v1 FOR n1 IN (\"Jan\", \"Feb\")) UNPIVOT(v2 FOR n2 IN (\"Nor\", \"Sou\"))", "WITH T AS (SELECT 1 AS \"Id\", 2 AS \"Jan\", 3 AS \"Feb\", 4 AS \"Nor\", 5 AS \"Sou\") SELECT T.\"Id\" AS \"Id\", T.N1 AS N1, T.V1 AS V1, T.N2 AS N2, T.V2 AS V2 FROM T AS T UNPIVOT(V1 FOR N1 IN (\"Jan\", \"Feb\")) UNPIVOT(V2 FOR N2 IN (\"Nor\", \"Sou\")) AS T",
  "qualified star over the pivot alias of a pivoted table", "duckdb", "{}", "SELECT u.* FROM unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) AS u", "SELECT u.id AS id, u.north AS north, u.south AS south, u.month AS month, u.revenue AS revenue FROM unpivotable AS unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) AS u",
  "qualified star over the pivot alias, next to a joined plain source", "duckdb", "{}", "SELECT x.b, u.* FROM x JOIN unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) AS u ON x.a = u.id", "SELECT x.b AS b, u.id AS id, u.north AS north, u.south AS south, u.month AS month, u.revenue AS revenue FROM x AS x JOIN unpivotable AS unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) AS u ON x.a = u.id",
  "qualified star over the pivot alias of a pivoted CTE", "duckdb", "{}", "WITH c AS (SELECT id, jan, feb FROM unpivotable) SELECT piv.* FROM c UNPIVOT(revenue FOR month IN (jan, feb)) AS piv", "WITH c AS (SELECT unpivotable.id AS id, unpivotable.jan AS jan, unpivotable.feb AS feb FROM unpivotable AS unpivotable) SELECT piv.id AS id, piv.month AS month, piv.revenue AS revenue FROM c AS c UNPIVOT(revenue FOR month IN (jan, feb)) AS piv",
  "qualified star over the pivot alias of a pivoted subquery", "duckdb", "{}", "SELECT piv.* FROM (SELECT id, jan, feb FROM unpivotable) UNPIVOT(revenue FOR month IN (jan, feb)) AS piv", "SELECT piv.id AS id, piv.month AS month, piv.revenue AS revenue FROM (SELECT unpivotable.id AS id, unpivotable.jan AS jan, unpivotable.feb AS feb FROM unpivotable AS unpivotable) AS _0 UNPIVOT(revenue FOR month IN (jan, feb)) AS piv",
  "qualified star over the alias of a chain of operators", "duckdb", "{}", "SELECT u.* FROM unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south)) AS u", "SELECT u.id AS id, u.month AS month, u.revenue AS revenue, u.region AS region, u.headcount AS headcount FROM unpivotable AS unpivotable UNPIVOT(revenue FOR month IN (jan, feb)) UNPIVOT(headcount FOR region IN (north, south)) AS u",
  "resolve Snowflake positional references inside composed expressions", "snowflake", "{}", "WITH t AS (SELECT PARSE_JSON('{\"id\": 1}') AS data, 'file' AS filepath) SELECT t.$1:\"id\"::INT AS id, t.$2 AS filename FROM t", "WITH T AS (SELECT PARSE_JSON('{\"id\": 1}') AS DATA, 'file' AS FILEPATH) SELECT CAST(GET_PATH(T.DATA, 'id') AS INT) AS ID, T.FILEPATH AS FILENAME FROM T AS T",
  "resolve Snowflake positional reference to a quoted column", "snowflake", "{}", "WITH t AS (SELECT 1 AS \"lower\") SELECT t.$1 FROM t", "WITH T AS (SELECT 1 AS \"lower\") SELECT T.\"lower\" AS \"lower\" FROM T AS T",
  "preserve explicit quotes when resolving Snowflake positional references", "snowflake", "{}", "WITH t AS (SELECT 1 AS \"SELECT\") SELECT t.$1 FROM t", "WITH T AS (SELECT 1 AS \"SELECT\") SELECT T.\"SELECT\" AS \"SELECT\" FROM T AS T",
  "preserve ambiguous Snowflake positional reference and resolve unique one", "snowflake", "{}", "WITH t AS (SELECT 1 AS x, 2 AS x, 3 AS y) SELECT t.$2, t.$3 FROM t", "WITH T AS (SELECT 1 AS X, 2 AS X, 3 AS Y) SELECT T.$2 AS _COL_0, T.Y AS Y FROM T AS T",
  "resolve Snowflake positional reference with CTE column aliases", "snowflake", "{}", "WITH t(\"lower\") AS (SELECT 1) SELECT t.$1 FROM t", "WITH T AS (SELECT 1 AS \"lower\") SELECT T.\"lower\" AS \"lower\" FROM T AS T",
  "preserve Snowflake positional reference through UNPIVOT", "snowflake", "{}", "WITH t AS (SELECT 1 AS \"SELECT\", 2 AS a, 3 AS b) SELECT t.$1 FROM t UNPIVOT(v FOR k IN (a, b))", "WITH T AS (SELECT 1 AS \"SELECT\", 2 AS A, 3 AS B) SELECT T.$1 AS _COL_0 FROM T AS T UNPIVOT(V FOR K IN (A, B)) AS T",
  "preserve Snowflake positional reference through aliased PIVOT", "snowflake", "{}", "WITH t AS (SELECT 1 AS id, 2 AS v, 'a' AS k) SELECT p.$2 FROM t PIVOT(SUM(v) FOR k IN ('a' AS \"SELECT\")) AS p", "WITH T AS (SELECT 1 AS ID, 2 AS V, 'a' AS K) SELECT P.$2 AS _COL_0 FROM T AS T PIVOT(SUM(T.V) FOR T.K IN ('a' AS \"SELECT\")) AS P",
  "retarget Snowflake positional reference to generated PIVOT alias", "snowflake", "{}", "WITH t AS (SELECT 1 AS id, 2 AS v, 'a' AS k) SELECT t.$2 FROM t PIVOT(SUM(v) FOR k IN ('a' AS a))", "WITH T AS (SELECT 1 AS ID, 2 AS V, 'a' AS K) SELECT _0.$2 AS _COL_0 FROM T AS T PIVOT(SUM(T.V) FOR T.K IN ('a' AS A)) AS _0",
  "retarget Snowflake positional reference to final chained operator", "snowflake", "{}", "WITH t AS (SELECT 1 AS id, 2 AS v, 'a' AS k) SELECT t.$1 FROM t PIVOT(SUM(v) FOR k IN ('a' AS a)) UNPIVOT(v2 FOR k2 IN (a))", "WITH T AS (SELECT 1 AS ID, 2 AS V, 'a' AS K) SELECT T.$1 AS _COL_0 FROM T AS T PIVOT(SUM(T.V) FOR T.K IN ('a' AS A)) UNPIVOT(V2 FOR K2 IN (A)) AS T",

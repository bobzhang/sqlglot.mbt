  "207, SELECT /*+ BROADCAST(y) */ x.b FROM x JOIN y ON x.b = y.b", "spark", "{}", "SELECT /*+ BROADCAST(y) */ x.b FROM x JOIN y ON x.b = y.b", "SELECT /*+ BROADCAST(y) */ x.b AS b FROM x AS x JOIN y AS y ON x.b = y.b",
  "208, SELECT c FROM x LATERAL VIEW EXPLODE (a) AS c", "", "{}", "SELECT c FROM x LATERAL VIEW EXPLODE (a) AS c", "SELECT _0.c AS c FROM x AS x LATERAL VIEW EXPLODE(x.a) _0 AS c",
  "209, SELECT c FROM xx LATERAL VIEW EXPLODE (a) AS c", "", "{\"schema\": \"{\\\"xx\\\": {\\\"a\\\": \\\"ARRAY<INT>\\\"}}\"}", "SELECT c FROM xx LATERAL VIEW EXPLODE (a) AS c", "SELECT _0.c AS c FROM xx AS xx LATERAL VIEW EXPLODE(xx.a) _0 AS c",
  "210, SELECT c FROM x LATERAL VIEW EXPLODE (a) t AS c", "", "{}", "SELECT c FROM x LATERAL VIEW EXPLODE (a) t AS c", "SELECT t.c AS c FROM x AS x LATERAL VIEW EXPLODE(x.a) t AS c",
  "211, SELECT aa FROM x, UNNEST(a) AS t(aa)", "", "{}", "SELECT aa FROM x, UNNEST(a) AS t(aa)", "SELECT t.aa AS aa FROM x AS x, UNNEST(x.a) AS t(aa)",
  "212, SELECT aa FROM x, UNNEST(a) AS aa", "bigquery", "{}", "SELECT aa FROM x, UNNEST(a) AS aa", "SELECT aa AS aa FROM x AS x CROSS JOIN UNNEST(x.a) AS aa",
  "213, select * from unnest ([1, 2]) as x with offset", "bigquery", "{}", "select * from unnest ([1, 2]) as x with offset", "SELECT x AS x, offset AS offset FROM UNNEST([1, 2]) AS x WITH OFFSET AS offset",
  "214, select * from unnest ([1, 2]) as x with offset as y", "bigquery", "{}", "select * from unnest ([1, 2]) as x with offset as y", "SELECT x AS x, y AS y FROM UNNEST([1, 2]) AS x WITH OFFSET AS y",
  "215, select x, a, x.a from unnest([STRUCT(1 AS a)]) as x CROSS JOIN m", "bigquery", "{}", "select x, a, x.a from unnest([STRUCT(1 AS a)]) as x CROSS JOIN m", "SELECT x AS x, a AS a, x.a AS a FROM UNNEST([STRUCT(1 AS a)]) AS x CROSS JOIN m AS m",
  "216, WITH cte AS (SELECT [STRUCT(1 AS a)] AS x) select a, x, m.a from cte, UNNEST(x) AS m CROSS JOIN n", "bigquery", "{}", "WITH cte AS (SELECT [STRUCT(1 AS a)] AS x) select a, x, m.a from cte, UNNEST(x) AS m CROSS JOIN n", "WITH cte AS (SELECT [STRUCT(1 AS a)] AS x) SELECT a AS a, cte.x AS x, m.a AS a FROM cte AS cte CROSS JOIN UNNEST(cte.x) AS m CROSS JOIN n AS n",
  "217, SELECT x.a, i.b FROM x CROSS JOIN UNNEST(SPLIT(CAST(b AS VARCHAR), ',')) AS i(b)", "presto", "{}", "SELECT x.a, i.b FROM x CROSS JOIN UNNEST(SPLIT(CAST(b AS VARCHAR), ',')) AS i(b)", "SELECT x.a AS a, i.b AS b FROM x AS x CROSS JOIN UNNEST(SPLIT(CAST(x.b AS VARCHAR), ',')) AS i(b)",
  "218, SELECT c FROM (SELECT 1 a) AS x LATERAL VIEW EXPLODE(a) AS c", "", "{}", "SELECT c FROM (SELECT 1 a) AS x LATERAL VIEW EXPLODE(a) AS c", "SELECT _0.c AS c FROM (SELECT 1 AS a) AS x LATERAL VIEW EXPLODE(x.a) _0 AS c",
  "219, SELECT * FROM foo(bar) AS t(c1, c2, c3)", "", "{}", "SELECT * FROM foo(bar) AS t(c1, c2, c3)", "SELECT t.c1 AS c1, t.c2 AS c2, t.c3 AS c3 FROM FOO(bar) AS t(c1, c2, c3)",
  "220, SELECT c1, c3 FROM foo(bar) AS t(c1, c2, c3)", "", "{}", "SELECT c1, c3 FROM foo(bar) AS t(c1, c2, c3)", "SELECT t.c1 AS c1, t.c3 AS c3 FROM FOO(bar) AS t(c1, c2, c3)",
  "221, SELECT c.f::VARCHAR(MAX) AS f, e AS e FROM a.b AS c, c.d AS e", "redshift", "{}", "SELECT c.f::VARCHAR(MAX) AS f, e AS e FROM a.b AS c, c.d AS e", "SELECT CAST(c.f AS VARCHAR(MAX)) AS f, e AS e FROM a.b AS c, c.d AS e",
  "222, WITH cte AS (SELECT 1 AS col) SELECT * FROM cte LEFT JOIN UNNEST((SELECT ARRAY_AGG(DISTINCT x) AS agg FROM UNNEST([1]) AS x WHERE col = 1))", "bigquery", "{}", "WITH cte AS (SELECT 1 AS col) SELECT * FROM cte LEFT JOIN UNNEST((SELECT ARRAY_AGG(DISTINCT x) AS agg FROM UNNEST([1]) AS x WHERE col = 1))", "WITH cte AS (SELECT 1 AS col) SELECT * FROM cte AS cte LEFT JOIN UNNEST((SELECT ARRAY_AGG(DISTINCT x) AS agg FROM UNNEST([1]) AS x WHERE cte.col = 1))",
  "223, SELECT * FROM UNNEST(ARRAY<STRUCT<percentile STRING, value INT64, score FLOAT64>>[(\"p10\", 1, 0.0)])", "bigquery", "{}", "SELECT * FROM UNNEST(ARRAY<STRUCT<percentile STRING, value INT64, score FLOAT64>>[(\"p10\", 1, 0.0)])", "SELECT percentile AS percentile, value AS value, score AS score FROM UNNEST(ARRAY<STRUCT<percentile STRING, value INT64, score FLOAT64>>[('p10', 1, 0.0)])",
  "224, WITH scores AS (SELECT * FROM UNNEST((SELECT ARRAY<STRUCT<percentile STRING, value INT64, score FLOAT64>>[(\"p10\", 1, 0.0)]))) SELECT percentile FROM scores", "bigquery", "{}", "WITH scores AS (SELECT * FROM UNNEST((SELECT ARRAY<STRUCT<percentile STRING, value INT64, score FLOAT64>>[(\"p10\", 1, 0.0)]))) SELECT percentile FROM scores", "WITH scores AS (SELECT percentile AS percentile, value AS value, score AS score FROM UNNEST((SELECT ARRAY<STRUCT<percentile STRING, value INT64, score FLOAT64>>[('p10', 1, 0.0)] AS _col_0))) SELECT scores.percentile AS percentile FROM scores AS scores",
  "ORDER BY in window function", "", "{}", "SELECT a + 1 AS a, ROW_NUMBER() OVER (PARTITION BY b ORDER BY a) AS row_num FROM x ORDER BY a, row_num", "SELECT x.a + 1 AS a, ROW_NUMBER() OVER (PARTITION BY x.b ORDER BY x.a) AS row_num FROM x AS x ORDER BY a, row_num",
  "226, SELECT ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) AS row_num FROM x QUALIFY row_num = 1", "bigquery", "{}", "SELECT ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) AS row_num FROM x QUALIFY row_num = 1", "SELECT ROW_NUMBER() OVER (PARTITION BY x.a ORDER BY x.b) AS row_num FROM x AS x QUALIFY ROW_NUMBER() OVER (PARTITION BY x.a ORDER BY x.b) = 1",
  "227, SELECT x.b, x.a FROM x LEFT JOIN y ON x.b = y.b QUALIFY ROW_NUMBER() OVER(PARTITION BY x.b ORDER BY x.a DESC) = 1 ORDER BY x.b, x.a", "bigquery", "{}", "SELECT x.b, x.a FROM x LEFT JOIN y ON x.b = y.b QUALIFY ROW_NUMBER() OVER(PARTITION BY x.b ORDER BY x.a DESC) = 1 ORDER BY x.b, x.a", "SELECT x.b AS b, x.a AS a FROM x AS x LEFT JOIN y AS y ON x.b = y.b QUALIFY ROW_NUMBER() OVER (PARTITION BY x.b ORDER BY x.a DESC) = 1 ORDER BY x.b, x.a",

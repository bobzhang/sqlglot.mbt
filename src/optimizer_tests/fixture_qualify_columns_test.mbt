  "251, SELECT * FROM ((SELECT * FROM x) INNER JOIN y ON a = c)", "", "{}", "SELECT * FROM ((SELECT * FROM x) INNER JOIN y ON a = c)", "SELECT y.b AS b, y.c AS c, _0.a AS a, _0.b AS b FROM ((SELECT x.a AS a, x.b AS b FROM x AS x) AS _0 INNER JOIN y AS y ON _0.a = y.c)",

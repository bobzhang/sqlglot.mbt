  "253, SELECT * FROM ((SELECT * FROM x) INNER JOIN (SELECT * FROM y) ON a = c)", "", "{}", "SELECT * FROM ((SELECT * FROM x) INNER JOIN (SELECT * FROM y) ON a = c)", "SELECT _0.a AS a, _0.b AS b, _1.b AS b, _1.c AS c FROM ((SELECT x.a AS a, x.b AS b FROM x AS x) AS _0 INNER JOIN (SELECT y.b AS b, y.c AS c FROM y AS y) AS _1 ON _0.a = _1.c)",

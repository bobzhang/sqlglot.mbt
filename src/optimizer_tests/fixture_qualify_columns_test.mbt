  "173, SELECT * REPLACE(COALESCE(b, a) AS a, a as b) FROM x", "", "{}", "SELECT * REPLACE(COALESCE(b, a) AS a, a as b) FROM x", "SELECT COALESCE(x.b, x.a) AS a, x.a AS b FROM x AS x",
  "174, SELECT * REPLACE(1 AS a) RENAME(b as alias_b) FROM x", "", "{}", "SELECT * REPLACE(1 AS a) RENAME(b as alias_b) FROM x", "SELECT 1 AS a, x.b AS alias_b FROM x AS x",
  "175, SELECT * EXCEPT(a) REPLACE(COALESCE(a, b) AS b) RENAME(b AS new_b) FROM x", "", "{}", "SELECT * EXCEPT(a) REPLACE(COALESCE(a, b) AS b) RENAME(b AS new_b) FROM x", "SELECT COALESCE(x.a, x.b) AS new_b FROM x AS x",
  "176, SELECT * REPLACE(1 AS a, a AS b) RENAME(b AS new_b) FROM x", "", "{}", "SELECT * REPLACE(1 AS a, a AS b) RENAME(b AS new_b) FROM x", "SELECT 1 AS a, x.a AS new_b FROM x AS x",
  "177, SELECT x.b FROM x JOIN y USING (b)", "", "{}", "SELECT x.b FROM x JOIN y USING (b)", "SELECT x.b AS b FROM x AS x JOIN y AS y ON x.b = y.b",
  "178, WITH cte AS (SELECT a.b.c.d.f.g FROM tbl1) SELECT g FROM (SELECT g FROM tbl2) tbl2 JOIN cte USING(g)", "", "{\"schema\": \"{\\\"tbl1\\\": {\\\"a\\\": \\\"STRUCT<b STRUCT<c STRUCT<d STRUCT<f STRUCT<g INT>>>>>\\\"}, \\\"tbl2\\\": {\\\"g\\\": \\\"INT\\\"}}\"}", "WITH cte AS (SELECT a.b.c.d.f.g FROM tbl1) SELECT g FROM (SELECT g FROM tbl2) tbl2 JOIN cte USING(g)", "WITH cte AS (SELECT tbl1.a.b.c.d.f.g AS g FROM tbl1 AS tbl1) SELECT COALESCE(tbl2.g, cte.g) AS g FROM (SELECT tbl2.g AS g FROM tbl2 AS tbl2) AS tbl2 JOIN cte AS cte ON tbl2.g = cte.g",
  "179, SELECT x.b FROM x JOIN y USING (b) JOIN z USING (b)", "", "{}", "SELECT x.b FROM x JOIN y USING (b) JOIN z USING (b)", "SELECT x.b AS b FROM x AS x JOIN y AS y ON x.b = y.b JOIN z AS z ON x.b = z.b",
  "180, SELECT b FROM x AS x2 JOIN y AS y2 USING (b)", "", "{}", "SELECT b FROM x AS x2 JOIN y AS y2 USING (b)", "SELECT COALESCE(x2.b, y2.b) AS b FROM x AS x2 JOIN y AS y2 ON x2.b = y2.b",
  "181, SELECT b FROM x JOIN y USING (b) WHERE b = 1 and y.b = 2", "", "{}", "SELECT b FROM x JOIN y USING (b) WHERE b = 1 and y.b = 2", "SELECT COALESCE(x.b, y.b) AS b FROM x AS x JOIN y AS y ON x.b = y.b WHERE COALESCE(x.b, y.b) = 1 AND y.b = 2",
  "182, SELECT b FROM x JOIN y USING (b) JOIN z USING (b)", "", "{}", "SELECT b FROM x JOIN y USING (b) JOIN z USING (b)", "SELECT COALESCE(x.b, y.b, z.b) AS b FROM x AS x JOIN y AS y ON x.b = y.b JOIN z AS z ON x.b = z.b",
  "183, SELECT * FROM x JOIN y USING(b)", "", "{}", "SELECT * FROM x JOIN y USING(b)", "SELECT x.a AS a, COALESCE(x.b, y.b) AS b, y.c AS c FROM x AS x JOIN y AS y ON x.b = y.b",
  "184, SELECT x.* FROM x JOIN y USING(b)", "", "{}", "SELECT x.* FROM x JOIN y USING(b)", "SELECT x.a AS a, COALESCE(x.b, y.b) AS b FROM x AS x JOIN y AS y ON x.b = y.b",
  "185, SELECT * FROM x LEFT JOIN y USING(b)", "", "{}", "SELECT * FROM x LEFT JOIN y USING(b)", "SELECT x.a AS a, COALESCE(x.b, y.b) AS b, y.c AS c FROM x AS x LEFT JOIN y AS y ON x.b = y.b",
  "186, SELECT b FROM x JOIN y USING(b)", "", "{}", "SELECT b FROM x JOIN y USING(b)", "SELECT COALESCE(x.b, y.b) AS b FROM x AS x JOIN y AS y ON x.b = y.b",
  "187, SELECT b, c FROM x JOIN y USING(b)", "", "{}", "SELECT b, c FROM x JOIN y USING(b)", "SELECT COALESCE(x.b, y.b) AS b, y.c AS c FROM x AS x JOIN y AS y ON x.b = y.b",
  "188, SELECT b, c FROM y JOIN z USING(b, c)", "", "{}", "SELECT b, c FROM y JOIN z USING(b, c)", "SELECT COALESCE(y.b, z.b) AS b, COALESCE(y.c, z.c) AS c FROM y AS y JOIN z AS z ON y.b = z.b AND y.c = z.c",
  "189, SELECT * FROM y JOIN z USING(b, c)", "", "{}", "SELECT * FROM y JOIN z USING(b, c)", "SELECT COALESCE(y.b, z.b) AS b, COALESCE(y.c, z.c) AS c FROM y AS y JOIN z AS z ON y.b = z.b AND y.c = z.c",
  "190, SELECT * FROM y JOIN z USING(b, c) WHERE b = 2 AND c = 3", "", "{}", "SELECT * FROM y JOIN z USING(b, c) WHERE b = 2 AND c = 3", "SELECT COALESCE(y.b, z.b) AS b, COALESCE(y.c, z.c) AS c FROM y AS y JOIN z AS z ON y.b = z.b AND y.c = z.c WHERE COALESCE(y.b, z.b) = 2 AND COALESCE(y.c, z.c) = 3",
  "191, SELECT b FROM x JOIN t USING(a)", "", "{}", "SELECT b FROM x JOIN t USING(a)", "SELECT x.b AS b FROM x AS x JOIN t AS t ON x.a = t.a",
  "192, SELECT b FROM t JOIN x USING(a)", "", "{}", "SELECT b FROM t JOIN x USING(a)", "SELECT x.b AS b FROM t AS t JOIN x AS x ON t.a = x.a",
  "193, SELECT a FROM t1 JOIN t2 USING(a)", "", "{}", "SELECT a FROM t1 JOIN t2 USING(a)", "SELECT COALESCE(t1.a, t2.a) AS a FROM t1 AS t1 JOIN t2 AS t2 ON t1.a = t2.a",
  "194, WITH m(a) AS (SELECT 1), n(b) AS (SELECT 1) SELECT * FROM m JOIN n AS foo(a) USING (a)", "", "{}", "WITH m(a) AS (SELECT 1), n(b) AS (SELECT 1) SELECT * FROM m JOIN n AS foo(a) USING (a)", "WITH m AS (SELECT 1 AS a), n AS (SELECT 1 AS b) SELECT COALESCE(m.a, foo.a) AS a FROM m AS m JOIN n AS foo(a) ON m.a = foo.a",
  "coalesce the USING clause's columns (3 joins, 2 join columns)", "", "{}", "WITH t1 AS (SELECT 'x' AS id, DATE '2024-01-01' AS foo, 000 AS value), t2 AS (SELECT 'x' AS id, DATE '2024-02-02' AS foo, 123 AS value), t3 AS (SELECT 'x' AS id, DATE '2024-02-02' AS foo, 456 AS value) SELECT * FROM t1 FULL OUTER JOIN t2 USING(id, foo) FULL OUTER JOIN t3 USING(id, foo)", "WITH t1 AS (SELECT 'x' AS id, CAST('2024-01-01' AS DATE) AS foo, 000 AS value), t2 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 123 AS value), t3 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 456 AS value) SELECT COALESCE(t1.id, t2.id, t3.id) AS id, COALESCE(t1.foo, t2.foo, t3.foo) AS foo, t1.value AS value, t2.value AS value, t3.value AS value FROM t1 AS t1 FULL OUTER JOIN t2 AS t2 ON t1.id = t2.id AND t1.foo = t2.foo FULL OUTER JOIN t3 AS t3 ON COALESCE(t1.id, t2.id) = t3.id AND COALESCE(t1.foo, t2.foo) = t3.foo",
  "coalesce the USING clause's columns (3 joins, 3 join columns)", "", "{}", "WITH t1 AS (SELECT 'x' AS id, CAST('2024-01-01' AS DATE) AS foo, 000 AS value), t2 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 123 AS value), t3 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 456 AS value) SELECT * FROM t1 FULL OUTER JOIN t2 USING (id, foo, value) FULL OUTER JOIN t3 USING (id, foo, value)", "WITH t1 AS (SELECT 'x' AS id, CAST('2024-01-01' AS DATE) AS foo, 000 AS value), t2 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 123 AS value), t3 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 456 AS value) SELECT COALESCE(t1.id, t2.id, t3.id) AS id, COALESCE(t1.foo, t2.foo, t3.foo) AS foo, COALESCE(t1.value, t2.value, t3.value) AS value FROM t1 AS t1 FULL OUTER JOIN t2 AS t2 ON t1.id = t2.id AND t1.foo = t2.foo AND t1.value = t2.value FULL OUTER JOIN t3 AS t3 ON COALESCE(t1.id, t2.id) = t3.id AND COALESCE(t1.foo, t2.foo) = t3.foo AND COALESCE(t1.value, t2.value) = t3.value",
  "coalesce the USING clause's columns (4 joins, 2 join columns)", "", "{}", "WITH t1 AS (SELECT 'x' AS id, CAST('2024-01-01' AS DATE) AS foo, 000 AS value), t2 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 123 AS value), t3 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 456 AS value), t4 AS (SELECT 'x' AS id, CAST('2024-03-03' AS DATE) AS foo, 789 AS value) SELECT * FROM t1 FULL OUTER JOIN t2 USING (id, foo) FULL OUTER JOIN t3 USING (id, foo) FULL OUTER JOIN t4 USING (id, foo)", "WITH t1 AS (SELECT 'x' AS id, CAST('2024-01-01' AS DATE) AS foo, 000 AS value), t2 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 123 AS value), t3 AS (SELECT 'x' AS id, CAST('2024-02-02' AS DATE) AS foo, 456 AS value), t4 AS (SELECT 'x' AS id, CAST('2024-03-03' AS DATE) AS foo, 789 AS value) SELECT COALESCE(t1.id, t2.id, t3.id, t4.id) AS id, COALESCE(t1.foo, t2.foo, t3.foo, t4.foo) AS foo, t1.value AS value, t2.value AS value, t3.value AS value, t4.value AS value FROM t1 AS t1 FULL OUTER JOIN t2 AS t2 ON t1.id = t2.id AND t1.foo = t2.foo FULL OUTER JOIN t3 AS t3 ON COALESCE(t1.id, t2.id) = t3.id AND COALESCE(t1.foo, t2.foo) = t3.foo FULL OUTER JOIN t4 AS t4 ON COALESCE(t1.id, t2.id, t3.id) = t4.id AND COALESCE(t1.foo, t2.foo, t3.foo) = t4.foo",
  "Name anonymous STRUCT fields if replacing USING columns", "", "{}", "WITH t1 AS (SELECT 1 AS id), t2 AS (SELECT 2 AS id) SELECT STRUCT(id) AS my_field FROM t1 JOIN t2 USING (id)", "WITH t1 AS (SELECT 1 AS id), t2 AS (SELECT 2 AS id) SELECT STRUCT(COALESCE(t1.id, t2.id) AS id) AS my_field FROM t1 AS t1 JOIN t2 AS t2 ON t1.id = t2.id",
  "Do not rename aliased STRUCT fields if replacing USING columns", "", "{}", "WITH t1 AS (SELECT 1 AS id), t2 AS (SELECT 2 AS id) SELECT STRUCT(id AS col) AS my_field FROM t1 JOIN t2 USING (id)", "WITH t1 AS (SELECT 1 AS id), t2 AS (SELECT 2 AS id) SELECT STRUCT(COALESCE(t1.id, t2.id) AS col) AS my_field FROM t1 AS t1 JOIN t2 AS t2 ON t1.id = t2.id",
  "200, SELECT b FROM x NATURAL JOIN y", "", "{}", "SELECT b FROM x NATURAL JOIN y", "SELECT COALESCE(x.b, y.b) AS b FROM x AS x JOIN y AS y ON x.b = y.b",
  "201, SELECT * FROM x NATURAL JOIN y", "", "{}", "SELECT * FROM x NATURAL JOIN y", "SELECT x.a AS a, COALESCE(x.b, y.b) AS b, y.c AS c FROM x AS x JOIN y AS y ON x.b = y.b",
  "202, SELECT a FROM x NATURAL JOIN z", "", "{}", "SELECT a FROM x NATURAL JOIN z", "SELECT x.a AS a FROM x AS x JOIN z AS z ON x.b = z.b",
  "203, SELECT b FROM x NATURAL JOIN y NATURAL JOIN z", "", "{}", "SELECT b FROM x NATURAL JOIN y NATURAL JOIN z", "SELECT COALESCE(x.b, y.b, z.b) AS b FROM x AS x JOIN y AS y ON x.b = y.b JOIN z AS z ON COALESCE(x.b, y.b) = z.b AND y.c = z.c",
  "204, SELECT a, d FROM x NATURAL LEFT JOIN w", "", "{}", "SELECT a, d FROM x NATURAL LEFT JOIN w", "SELECT x.a AS a, w.d AS d FROM x AS x NATURAL LEFT JOIN w AS w",
